@* Standard app button. Variants map to semantic roles, sizes respect
   glove-friendly touch minimums (48px, 56px primary). Use instead of
   ad-hoc styled <button> elements in new/refactored markup. *@
<button @attributes="AdditionalAttributes"
        type="@Type"
        class="AppButton @VariantCss @SizeCss @(FullWidth ? "Full" : string.Empty)"
        disabled="@(Disabled || Busy)"
        aria-busy="@(Busy ? "true" : null)"
        @onclick="HandleClickAsync">
    @if (Busy)
    {
        <span class="Spin" aria-hidden="true"></span>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <i class="bi @Icon" aria-hidden="true"></i>
    }
    @if (ChildContent is not null)
    {
        <span class="Label">@ChildContent</span>
    }
</button>

@code {
    public enum ButtonVariant { Primary, Secondary, Tertiary, Destructive }
    public enum ButtonSize { Default, Large }

    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Default;
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantCss => Variant.ToString();
    private string SizeCss => Size == ButtonSize.Large ? "Large" : string.Empty;

    private async Task HandleClickAsync()
    {
        if (Disabled || Busy)
            return;

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }
}
