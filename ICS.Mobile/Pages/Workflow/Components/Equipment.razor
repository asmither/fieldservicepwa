        case WFEquipmentModes.ChooseManufacturer:
            <div class="WorkflowEditItem">
                <DataPicker @ref="mfgPicker" DataList="@EquipmentManufacturerList" Title="Mfg" ListId="equipment-manufactures" @bind-value="@EquipmentManufacturer"></DataPicker>
                @if (EquipmentManufacturerTemp != null)
                {
                    <div style="border:2px dashed; padding:6px;">
                        <br />
                        <span>Edit this Entry:</span>
                        <SmallTextInput @bind-value="@EquipmentManufacturerTemp"></SmallTextInput>
                        <ICSDismissable Message="@ErrorMessage"></ICSDismissable>
                        <div class="SingleLineWithButton">
                            <br />
                            <button class="button" style="padding: 3px; border: 2px solid inset; border-color: darkred; background-color: red; color: white" @onclick="() => SetMfgManuallyEdited(1)">
                                USE MY EDIT
                            </button> <span>&nbsp; &nbsp;</span>
                            <button class="button" style="padding: 3px; border: 2px solid inset; border-color: dimgrey; background-color: lightgrey; color: black;" @onclick="() => EquipmentManufacturer=null">
                                &nbsp; CANCEL EDITS &nbsp;
                            </button>
                        </div>
                        <br />
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(DataPlateText))
                    {
                        <div class="DataPlateNotes">
                            <TinyPicker DataList="DataPlateList" Title="Tap to edit plate items" @bind-Value="@EquipmentManufacturerTemp" />
                            @* <pre class="EqValue">@((MarkupString)PageBase.TextToHtml(DataPlateText))</pre> *@
                        </div>
                    }
                }
                @if (DataPlateImage?.ContentType is not null)
                {
                    <div class="WorkflowImageMedia">
                        @* <div class="WorkflowPrompt">Data Plate Image:</div> *@
                        <div class="Image">
                            <img src="@DataPlateImage.Base64Version()" alt="DataPlate Photo">
                        </div>
                        <div class="ButtonWrapper">
                            <button type="button" class="Button" @onclick="() => ProcessDPPhoto()">
                                <Icon UseIcon="Read" Title="Re-Read This DataPlate" />
                            </button>
                        </div>
                    </div>
                    <script defer>
                        window.scrollToTop();
                    </script>
                }

            </div>

            break;

        case WFEquipmentModes.EnterModel:
            <div class="WorkflowEditItem">
                <div class="Prompt">Model Number:</div>
                <div class="Hints">Enter the model from the dataplate.</div>
