                                        @* <i class="bi bi-trash"></i> *@
                                        <Icon UseIcon="Trashcan" Title="@(string.Concat("Delete ",consumable.Name))" />
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="EquipmentContentLine">No items yet.</div>
                        }
                    </div>
                </div>

                <div class="EquipmentContainer">
                    <div class="Header">
                        Available Consumables
                    </div>
                    <div class="Content">
                        @if (SelectedEquipment.AvailableConsumables.Count != 0)
                        {
                            @foreach (var consumable in SelectedEquipment.AvailableConsumables)
                            {
                                <div class="SingleLineWithButton">
                                    <div class="Text">
                                        @consumable.Name
                                    </div>
                                    <button class="Button Transparent" @onclick="() => AddConsumable(consumable)">
                                        <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Add" Title="@string.Concat("Add new ", consumable.Name)" />
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div>No consumables available.</div>
                        }
                    </div>
                </div>
            }

            break;

        case WFEquipmentModes.Attributes:

