                                </button>
                            </center>
                        }
                    }
                </div>
                <DateOnlyInput @bind-Value="@ManufactureDate" UserFastPicker="true"></DateOnlyInput>
                @if (MfgDateTemp != null)
                {
                    <div style="border:2px dashed; padding:6px;">
                        <br />
                        <span>FIX THIS AS DATE:</span>
                        <SmallTextInput @bind-value="@MfgDateTemp"></SmallTextInput>
                        <ICSDismissable Message="@ErrorMessage"></ICSDismissable>
                        <div class="SingleLineWithButton">
                            <br />
                            <button class="button" style="padding: 3px; border: 2px solid inset; border-color: darkred; background-color: red; color: white" @onclick="() => SetDateManuallyEdited(1)">
                                SAVE/USE MY EDITS
                            </button> <span>&nbsp; &nbsp;</span>
                            <button class="button" style="padding: 3px; border: 2px solid inset; border-color: dimgrey; background-color: lightgrey; color: black;" @onclick="() => MfgDateTemp=null">
                                &nbsp; CANCEL EDITS &nbsp;
                            </button>
                        </div>
                        <br />
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(DataPlateText))
                    {
                        <div class="DataPlateNotes">
                            <TinyPicker DataList="DataPlateListNumericsOnly" Title="Mfg Date from Plate" @bind-Value="@MfgDateEdit" />
                        </div>
                    }
                }
                @if (DataPlateImage?.ContentType is not null)
                {
                    <div class="WorkflowImageMedia">
                        @* <div class="WorkflowPrompt">Data Plate Image:</div> *@
                        <div class="Image">
                            <img src="@DataPlateImage.Base64Version()" alt="DataPlate Photo">
                        </div>
                        <div class="ButtonWrapper">
                            <button type="button" class="Button" @onclick="() => ProcessDPPhoto()">
                                <Icon UseIcon="Read" Title="Re-Read This DataPlate" />
                            </button>
                        </div>

                    </div>
                    <script defer>
                        window.scrollToTop();
                    </script>
                }

            </div>
            break;

        case WFEquipmentModes.InstallDate:
            <div class="WorkflowEditItem">
                <div class="Prompt">Install Date:</div>
                <div class="Hints">Enter installed date known.</div>
                <DateOnlyInput @bind-Value="@InstallDate"></DateOnlyInput>
                @if (InstDateTemp != null)
                {
                    <div style="border:2px dashed; padding:6px;">
                        <br />
                        <span>MAKE THIS A DATE:</span>
                        <SmallTextInput @bind-value="@InstDateTemp"></SmallTextInput>
                        <ICSDismissable Message="@ErrorMessage"></ICSDismissable>
                        <div>
                            <br />
                            <button class="button" style="padding: 3px; border: 2px solid inset; border-color: darkred; background-color: red; color: white" @onclick="() => SetDateManuallyEdited(2)">TRY MY EDITS</button>
                            <span>&nbsp; &nbsp;</span>
                            <button class="button" style="padding: 3px; border: 2px solid inset; border-color: dimgrey; background-color: lightgrey; color: black;" @onclick="() => InstDateTemp=null">&nbsp; CANCEL &nbsp;</button>
                        </div>
                        <br />
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(DataPlateText))
                    {
                        <div class="DataPlateNotes">
                            <TinyPicker DataList="DataPlateListNumericsOnly" Title="Pick Mfg Date from Plate" @bind-Value="@InstDateEdit" />
                        </div>
                    }
                }
                @if (DataPlateImage?.ContentType is not null)
                {
                    <div class="WorkflowImageMedia">
                        @* <div class="WorkflowPrompt">Data Plate Image:</div> *@
                        <div class="Image">
                            <img src="@DataPlateImage.Base64Version()" alt="DataPlate Photo">
                        </div>
                        <div class="ButtonWrapper">
                            <button type="button" class="Button" @onclick="() => ProcessDPPhoto()">
                                <Icon UseIcon="Read" Title="Re-Read This DataPlate" />
                            </button>
                        </div>

                    </div>
                    <script defer>
                        window.scrollToTop();
                    </script>
                }
            </div>
            break;

        case WFEquipmentModes.EquipmentType:
            <div class="WorkflowEditItem">
                <ICSDismissable Message="@ErrorMessage"></ICSDismissable>
                <DataPicker DataList="@EquipmentTypeList" Title="Unit Type" ListId="equipment-types" @bind-value="@EquipmentType"></DataPicker>
            </div>
            break;

        case WFEquipmentModes.UnitTag:
            <div class="WorkflowEditItem">
                <div class="Prompt">Equipment Nickname</div>
