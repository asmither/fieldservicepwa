                {
                    <div class="WorkflowImageMedia">
                        @* <div class="WorkflowPrompt">Data Plate Image:</div> *@
                        <div class="Image">
                            <img src="@DataPlateImage.Base64Version()" alt="DataPlate Photo">
                        </div>
                        <div class="ButtonWrapper">
                            <button type="button" class="Button" @onclick="() => ProcessDPPhoto()">
                                <Icon UseIcon="Read" Title="Re-Read This DataPlate" />
                            </button>
                        </div>
                    </div>
                    <script defer>
                        window.scrollToTop();
                    </script>
                }

            </div>
            break;

        case WFEquipmentModes.EnterSerialNumber:
            <div class="WorkflowEditItem">
                <div class="Prompt">Serial Number:</div>
                <div class="Hints">
                    Enter the unit serial# from dataplate.
                </div>
