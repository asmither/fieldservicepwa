                {
                    <div class="DataPlateNotes">
                        <TinyPicker DataList="DataPlateListNumericsOnly" Title="Serial#" @bind-Value="@EquipmentSerial" />
                    </div>
                }
                @if (DataPlateImage?.ContentType is not null)
                {
                    <div class="WorkflowImageMedia">
                        @* <div class="WorkflowPrompt">Data Plate Image:</div> *@
                        <div class="Image">
                            <img src="@DataPlateImage.Base64Version()" alt="DataPlate Photo">
                        </div>
                        <div class="ButtonWrapper">
                            <button type="button" class="Button" @onclick="() => ProcessDPPhoto()">
                                <Icon UseIcon="Read" Title="Re-Read This DataPlate" />
                            </button>
                        </div>

                    </div>
                    <script defer>
                        window.scrollToTop();
                    </script>
                }
            </div>
            break;

        case WFEquipmentModes.ManufactureDate:

            <div class="WorkflowEditItem">
                <div class="Prompt">Manufactured On Date:</div>
