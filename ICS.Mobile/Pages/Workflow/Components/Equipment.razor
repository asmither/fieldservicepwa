                    {
                        case WorkflowDataTypes.Choice:
                            <DataPicker DataList="@SelectedAttribute.Options" Title="@SelectedAttribute.Name" ListId="@SelectedAttribute.Uid.ToString()" @bind-value="@SelectedAttributeValueAsString"></DataPicker>
                            break;
                        case WorkflowDataTypes.Numeric:
                            <NumberInput @bind-Value="@SelectedAttributeValueAsDecimal"></NumberInput>
                            break;
                        case WorkflowDataTypes.Date:
                            <DateOnlyInput @bind-Value="@SelectedAttributeValueAsDateOnly"></DateOnlyInput>
                            break;
                        case WorkflowDataTypes.SmallText:
                            <SmallTextInput @bind-Value="@SelectedAttributeValueAsString"></SmallTextInput>
                            break;
                        case WorkflowDataTypes.LargeText:
                            <LargeTextInput @bind-Value="@SelectedAttributeValueAsString"></LargeTextInput>
