@using ICS.Mobile.Components
@inherits WorkflowComponentsBasePage
@layout EmptyLayout
@using ICS.Portal.Data.Queries.Models
@using ICS.Portal.Data.Enumerations;
@using ICS.Portal.Data.Custom
@if (Initialized)
{

    @switch (Mode)
    {
        case WFEquipmentModes.Selecting:

            @* ===== TOOLBAR: Search, Sort, Multi-Select Toggle ===== *@
            <div class="EquipmentToolbar">
                <div class="SearchContainer">
                    <i class="bi bi-search" @onclick="ToggleEquipmentFilter"></i>
                    <input type="text"
                           class="SearchInput"
                           placeholder="Search make, model, serial, tag..."
                           value="@SearchFilterText"
                           @oninput="OnSearchFilterChanged" />
                    @if (!string.IsNullOrEmpty(SearchFilterText))
                    {
                        <button class="ClearSearchBtn" @onclick="ClearSearchFilter">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>
                @if (EquipmentFilterMode)
                {
                    <div class="ToolbarActions">
                        @if (!MultiSelectMode)
                        {
                            <button class="ToolbarBtn" title="Hide these buttons" @onclick="ToggleEquipmentFilter"><i class="bi bi-x-circle"></i></button>
                        }
                        <button class="ToolbarBtn @((CurrentSortMode == EquipmentSortMode.UnitTag || CurrentSortMode == EquipmentSortMode.UnitTagDesc)? "SortByTag" : "")"
                                @onclick="ToggleSortMode"
                                title="Sort by @SortModeText">
                            @if (CurrentSortMode == EquipmentSortMode.ManufacturerDesc || CurrentSortMode == EquipmentSortMode.UnitTagDesc)
                            {
                                <i class="bi bi-sort-alpha-down-alt"></i>
                            }
                            else
                            {
                                <i class="bi bi-sort-alpha-up"></i>
                            }
                            <span class="BtnLabel">@SortModeText</span>
                        </button>
                        <button class="ToolbarBtn @(MultiSelectMode ? "Active" : "") MultiSelbtn"
                                @onclick="ToggleMultiSelectMode"
                                title="@(MultiSelectMode ? "Exit Multi-Select Mode" : "Multi-Select Equip to Move or Retire")">

                            @if (!MultiSelectMode)
                            {
                                <i class="bi bi-check2-square"></i>
                                <span class="BtnLabel">Move/Retire</span>
                            }
                            else
                            {
                                <i class="bi bi-x-square"></i>
                                <span class="BtnLabel">Exit Bulk Move/Retire</span>
                            }
                        </button>
                    </div>
                }
            </div>

            @* ===== MULTI-SELECT ACTION BAR (shown when in multi-select mode) ===== *@
            @if (MultiSelectMode)
            {
                <div class="MultiSelectBar">
                    <div class="SelectionInfo">
                        <span class="SelectCount">
                            <i>
                                @if (MultiSelectedEquipment.Count == 0)
                                {
                                    <small>Pick Units & Take Action</small>
                                }
                                else
                                {
                                    <span>@MultiSelectedEquipment.Count</span>

                                    @if (MultiSelectedEquipment.Count > 1)
                                    {
                                        <span> Units</span>
                                    }
                                    else
                                    {
                                        <span> Unit</span>
                                    }
                                }
                            </i>
                        </span>
                    </div>
                    <div class="SelectActions">
                        <button class="SelectActionBtn" @onclick="SelectAllVisible" title="Select All">
                            <i class="bi bi-check-all"></i>
                        </button>
                        <button class="SelectActionBtn" @onclick="DeselectAll" title="Deselect All">
                            <i class="bi bi-x-lg"></i>
                        </button>
                        <button class="SelectActionBtn Primary @(MultiSelectedEquipment.Count == 0 ? "Disabled" : "")"
                                @onclick="ShowBulkActions"
                                disabled="@(MultiSelectedEquipment.Count == 0)"
                                title="Move to Group or Retire">
                            <i class="bi bi-gear-fill"></i>
                            <span>TAKE ACTION</span>
                        </button>
                    </div>
                </div>
            }

            @* ===== NO RESULTS MESSAGE ===== *@
            @if (!string.IsNullOrEmpty(SearchFilterText) && !FilteredEquipmentList.Any())
            {
                <div class="NoResultsMessage">
                    <i class="bi bi-search"></i>
                    <p>No equipment matches "<strong>@SearchFilterText</strong>"</p>
                    <button class="Button" @onclick="ClearSearchFilter">Clear Search</button>
                </div>
            }


            @* ===== UNGROUPED EQUIPMENT ===== *@
            @foreach (WorkflowEquipment equipment in GetSortedEquipmentForGroup(null))
            {
                <div class="EquipmentContainer @EquipmentSelectedStyle(equipment) @EquipmentSelectedAlreadyStyle(equipment) @MultiSelectStyle(equipment)">
                    <div class="Header" @onclick="() => HandleEquipmentHeaderClick(equipment)">
                        @if (MultiSelectMode)
                        {
                            <div class="MultiSelectCheckbox">
                                <i class="bi @(IsMultiSelected(equipment) ? "bi-check-square-fill" : "bi-square")"></i>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(equipment.TypeName))
                        {
                            <div class="Name">
                                <strong>
                                    @if (CurrentSortMode == EquipmentSortMode.Manufacturer || CurrentSortMode == EquipmentSortMode.ManufacturerDesc)
                                    {
                                        @equipment.Make
                                    }
                                    @if (CurrentSortMode == EquipmentSortMode.UnitTag || CurrentSortMode == EquipmentSortMode.UnitTagDesc)
                                    {
                                        @equipment.UnitTag
                                    }
                                </strong>
                                <span class="EqTypeName">
                                    &nbsp; - &nbsp;
                                    @equipment.TypeName.ToLowerInvariant()
                                </span>
                            </div>
                        }
                        <div class="Image">
                            <i class="icon bi @SelectedEquipmentIcon(equipment)"></i>
                        </div>
                    </div>
                    <div class="Content">
                        <div class="MultiLineWithButton">
                            <div class="Text" @onclick="() => HandleEquipmentBodyClick(equipment)">
                                @RenderEquipmentDetails(equipment)
                            </div>
                            @if (AllowEdit && !MultiSelectMode)
                            {
                                <div class="Button Transparent" @onclick="() => SetEditEquipment(equipment)">
                                    <Icon Title="Edit this Equipment" UseIcon="EditClipboard" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @* ===== GROUPED EQUIPMENT ===== *@
            @foreach (string group in GroupList.Where(g => g != "Retired"))
            {
                var filteredCount = FilteredGroupCount(group);
                if (filteredCount != 0)
                {
                    <div class="EquipmentContainer Lighter @GroupSelectedAlreadyStyle(group)">
                        <div class="Header" @onclick="() => ToggleGroup(group)">
                            <div class="Name">
                                @group (@filteredCount)
                            </div>
                            <div class="Image">
                                @if (SelectedGroup == group)
                                {
                                    <i class="bi bi-chevron-double-up"></i>
                                }
                                else
                                {
                                    <i class="bi bi-chevron-double-down"></i>
                                }
                            </div>
                        </div>
                        @if (SelectedGroup == group)
                        {
                            <div class="Content">
                                @foreach (WorkflowEquipment equipment in GetSortedEquipmentForGroup(group))
                                {
                                    <div class="EquipmentContainer Lighter @EquipmentSelectedStyle(equipment) @EquipmentSelectedAlreadyStyle(equipment) @MultiSelectStyle(equipment)">
                                        @* === HEADER: Tap to select (single or multi) === *@
                                        <div class="Header" @onclick="() => HandleEquipmentHeaderClick(equipment)">
                                            @if (MultiSelectMode)
                                            {
                                                <div class="MultiSelectCheckbox">
                                                    <i class="bi @(IsMultiSelected(equipment) ? "bi-check-square-fill" : "bi-square")"></i>
                                                </div>
                                            }

                                            <div class="Name">
                                                <strong>
                                                    @if (CurrentSortMode == EquipmentSortMode.Manufacturer || CurrentSortMode == EquipmentSortMode.ManufacturerDesc)
                                                    {
                                                        @equipment.Make
                                                    }
                                                    @if (CurrentSortMode == EquipmentSortMode.UnitTag || CurrentSortMode == EquipmentSortMode.UnitTagDesc)
                                                    {
                                                        @equipment.UnitTag
                                                    }
                                                    <span class="EqTypeName">
                                                        &nbsp; - &nbsp;
                                                        @equipment.TypeName.ToLowerInvariant()
                                                    </span>
                                                </strong>
                                            </div>

                                            <div class="Image"><i class="@SelectedEquipmentIcon(equipment)"></i></div>
                                        </div>

                                        @* === CONTENT: Tap to edit === *@
                                        <div class="Content @EquipmentSelectedStyle(equipment) @EquipmentSelectedAlreadyStyle(equipment)">
                                            <div class="MultiLineWithButton">
                                                <div class="Text" @onclick="() => HandleEquipmentBodyClick(equipment)">
                                                    @RenderEquipmentDetails(equipment)
                                                </div>
                                                @if (AllowEdit && !MultiSelectMode)
                                                {
                                                    <div class="EquipmentEditIcon" @onclick="() => SetEditEquipment(equipment)">
                                                        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                            <path d="M9 5H7C5.89543 5 5 5.89543 5 7V19C5 20.1046 5.89543 21 7 21H9M15 5H17C18.1046 5 19 5.89543 19 7V9" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                            <path d="M14.902 20.3343L12.7153 20.7716L13.1526 18.585C13.1914 18.3914 13.2865 18.2136 13.4261 18.074L17.5 14L19.5 12L21.4869 13.9869L19.4869 15.9869L15.413 20.0608C15.2734 20.2004 15.0956 20.2956 14.902 20.3343Z" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                            <path d="M9 5C9 3.89543 9.89543 3 11 3H13C14.1046 3 15 3.89543 15 5V7H9V5Z" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                        </svg>
                                                    </div>
                                                }
                                            </div>
                                            @if (equipment.IsRetired)
                                            {
                                                <p class="text-bg-danger">** UNIT RETIRED!</p>
                                            }
                                        </div>
                                    </div>
                                    <div class="py-1"></div>
                                }
                            </div>
                        }
                    </div>
                }
                <div class="py-1"></div>
            }

            @* ===== RETIRED GROUP ===== *@
            @if (RetiredGroupPresent && FilteredGroupCount("Retired") > 0)
            {
                <div class="EquipmentContainer">
                    <div class="Header" @onclick='() => ToggleGroup("Retired")'>
                        <div class="Name">
                            Retired (@FilteredGroupCount("Retired"))
                        </div>
                        <div class="Image">
                            @if (SelectedGroup == "Retired")
                            {
                                <i class="bi bi-chevron-double-up"></i>
                            }
                            else
                            {
                                <i class="bi bi-chevron-double-down"></i>
                            }
                        </div>
                    </div>

                    @if (SelectedGroup == "Retired")
                    {
                        <div class="Content">
                            @foreach (WorkflowEquipment equipment in GetSortedEquipmentForGroup(null, retiredOnly: true))
                            {
                                <div class="EquipmentContainer Lighter @EquipmentSelectedStyle(equipment) @EquipmentSelectedAlreadyStyle(equipment) @MultiSelectStyle(equipment)">
                                    <div class="Header" @onclick="() => HandleEquipmentHeaderClick(equipment)">
                                        @if (MultiSelectMode)
                                        {
                                            <div class="MultiSelectCheckbox">
                                                <i class="bi @(IsMultiSelected(equipment) ? "bi-check-square-fill" : "bi-square")"></i>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(equipment.TypeName))
                                        {
                                            <div class="Name">
                                                <strong>
                                                    @if (CurrentSortMode == EquipmentSortMode.Manufacturer || CurrentSortMode == EquipmentSortMode.ManufacturerDesc)
                                                    {
                                                        @equipment.Make
                                                    }
                                                    @if (CurrentSortMode == EquipmentSortMode.UnitTag || CurrentSortMode == EquipmentSortMode.UnitTagDesc)
                                                    {
                                                        @equipment.UnitTag
                                                    }

                                                </strong>
                                                <span class="EqTypeName">
                                                    &nbsp; - &nbsp;
                                                    @equipment.TypeName.ToLowerInvariant()
                                                </span>
                                            </div>
                                        }
                                        <div class="Image"><i class="@SelectedEquipmentIcon(equipment)"></i></div>
                                    </div>
                                    <div class="Content @EquipmentSelectedAlreadyStyle(equipment)">
                                        <div class="MultiLineWithButton">
                                            <div class="Text" @onclick="() => HandleEquipmentBodyClick(equipment)">
                                                @RenderEquipmentDetails(equipment)
                                            </div>
                                            @if (AllowEdit && !MultiSelectMode)
                                            {
                                                <div class="EquipmentEditIcon" @onclick="() => SetEditEquipment(equipment)">
                                                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M9 5H7C5.89543 5 5 5.89543 5 7V19C5 20.1046 5.89543 21 7 21H9M15 5H17C18.1046 5 19 5.89543 19 7V9" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                        <path d="M14.902 20.3343L12.7153 20.7716L13.1526 18.585C13.1914 18.3914 13.2865 18.2136 13.4261 18.074L17.5 14L19.5 12L21.4869 13.9869L19.4869 15.9869L15.413 20.0608C15.2734 20.2004 15.0956 20.2956 14.902 20.3343Z" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                        <path d="M9 5C9 3.89543 9.89543 3 11 3H13C14.1046 3 15 3.89543 15 5V7H9V5Z" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                    </svg>
                                                </div>
                                            }
                                        </div>
                                        @if (equipment.IsRetired)
                                        {
                                            <p class="text-bg-danger">** UNIT RETIRED!</p>
                                        }
                                    </div>
                                </div>
                                <div class="py-1"></div>
                            }
                        </div>
                    }

                </div>
                <div class="py-1"></div>
            }

            @* ===== ADD NEW EQUIPMENT BUTTON ===== *@
            @if (AllowAdd && AddInProgress == false && !MultiSelectMode)
            {
                <div class="CenteredButtonContainer">
                    <button class="Button" @onclick="AddNewEquipment">
                        Add new equipment
                    </button>
                </div>
            }

            @* ===== BULK ACTIONS POPUP ===== *@
            @if (ShowBulkActionsPopup)
            {
                <div class="PopupOverlay" @onclick="ClosePopups">
                    <div class="PopupContainer" @onclick:stopPropagation="true">
                        <div class="PopupHeader">
                            <span>Bulk Actions</span>
                            <button class="PopupCloseBtn" @onclick="ClosePopups">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <div class="PopupContent">
                            <p class="PopupInfo">@MultiSelectedEquipment.Count item(s) selected</p>

                            <button class="PopupActionBtn" @onclick="BulkRetire">
                                <i class="bi bi-archive-fill"></i>
                                <span>Retire Selected</span>
                            </button>

                            <button class="PopupActionBtn" @onclick="BulkUnRetire">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                <span>Un-Retire Selected</span>
                            </button>

                            <button class="PopupActionBtn" @onclick="ShowMoveToGroup">
                                <i class="bi bi-folder-symlink-fill"></i>
                                <span>Move to Group</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            @* ===== MOVE TO GROUP POPUP ===== *@
            @if (ShowMoveToGroupPopup)
            {
                <div class="PopupOverlay" @onclick="()=>ClosePopups()">
                    <div class="PopupContainer MoveGroupPopup" @onclick:stopPropagation="true">
                        <div class="PopupHeader">
                            <span>Move to Group</span>
                            <button class="PopupCloseBtn" @onclick="()=>ClosePopups()">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <div class="PopupContent">
                            <p class="PopupInfo">Select a group for @MultiSelectedEquipment.Count item(s)</p>

                            <div class="GroupList">
                                @foreach (var group in GroupList.Where(g => g != "Retired"))
                                {
                                    <button class="GroupOption" @onclick="() => MoveToGroup(group)">
                                        <i class="bi bi-folder2"></i>
                                        <span>@group</span>
                                        <span class="GroupCount">(@GroupCount(group))</span>
                                    </button>
                                }
                                <button class="GroupOption Ungrouped" @onclick="() => RemoveFromGroup()">
                                    <i class="bi bi-folder2-open"></i>
                                    <span>Remove from Group</span>
                                </button>
                            </div>

                            @* Create New Group *@
                            <div class="NewGroupSection">
                                <div class="SectionDivider">
                                    <span>Or create new group</span>
                                </div>
                                <div class="NewGroupInput">
                                    <input type="text"
                                           class="WorkflowInput"
                                           placeholder="New group name..."
                                           @bind="NewGroupName"
                                           maxlength="36" />
                                    <button class="CreateGroupBtn"
                                            @onclick="() => CreateAndMoveToNewGroup()"
                                            disabled="@string.IsNullOrWhiteSpace(NewGroupName)">
                                        <i class="bi bi-plus-circle"></i>
                                        Create & Move
                                    </button>
                                </div>
                                @if (!string.IsNullOrEmpty(ErrorMessage))
                                {
                                    <p class="ErrorText">@ErrorMessage</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            break;

        case WFEquipmentModes.None:
            <p>Loading...</p>
            break;

        case WFEquipmentModes.UnitImage1:

            @if (UnitImage1!.ContentType is not null)
            {
                <div class="WorkflowImageMedia">
                    <div class="WorkflowPrompt">Unit Image 1:</div>
                    <div class="Image">
                        <img src="@UnitImage1.Base64Version()" alt="Image Label">
                    </div>
                    <div class="ButtonWrapper">
                        <button type="button" class="Button" @onclick="() => DeleteImage(WFEquipmentModes.UnitImage1)">
                            <Icon UseIcon="Trashcan" Title="Remove this Image" />
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="WorkflowEditItem">
                    <div class="Prompt">Unit Image 1:</div>
                    <div class="custom-file-upload">
                        @if (WorkflowStep is not null && WorkflowStep.RequireCamera.Equals(true))
                        {
                            <InputFile id="@UnitImage1.Id" OnChange="Unit1FileChanged" accept="image/*" capture="camera"></InputFile>
                        }
                        else
                        {
                            <InputFile id="@UnitImage1.Id" OnChange="Unit1FileChanged"></InputFile>
                        }
                        <label for="@UnitImage1.Id">
                            <span>
                                <i>(Required)</i>
                                <svg width="92px" height="92px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#FFFFFF"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M15 13H9" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round"></path> <path d="M12 10L12 16" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round"></path> <path d="M9.77778 21H14.2222C17.3433 21 18.9038 21 20.0248 20.2646C20.51 19.9462 20.9267 19.5371 21.251 19.0607C22 17.9601 22 16.4279 22 13.3636C22 10.2994 22 8.76721 21.251 7.6666C20.9267 7.19014 20.51 6.78104 20.0248 6.46268C19.3044 5.99013 18.4027 5.82123 17.022 5.76086C16.3631 5.76086 15.7959 5.27068 15.6667 4.63636C15.4728 3.68489 14.6219 3 13.6337 3H10.3663C9.37805 3 8.52715 3.68489 8.33333 4.63636C8.20412 5.27068 7.63685 5.76086 6.978 5.76086C5.59733 5.82123 4.69555 5.99013 3.97524 6.46268C3.48995 6.78104 3.07328 7.19014 2.74902 7.6666C2 8.76721 2 10.2994 2 13.3636C2 16.4279 2 17.9601 2.74902 19.0607C3.07328 19.5371 3.48995 19.9462 3.97524 20.2646C5.09624 21 6.65675 21 9.77778 21Z" stroke="#FFFFFF" stroke-width="1.5"></path> <path d="M19 10H18" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round"></path> </g></svg>
                            </span>
                        </label>
                    </div>
                </div>
            }
            break;

        case WFEquipmentModes.UnitImage2:

            @if (UnitImage2!.ContentType is not null)
            {
                <div class="WorkflowImageMedia">
                    <div class="WorkflowPrompt">Unit 2 Image:</div>
                    <div class="Image">
                        <img src="@UnitImage2.Base64Version()" alt="Image Label">
                    </div>
                    <div class="ButtonWrapper">
                        <button type="button" class="Button" @onclick="() => DeleteImage(WFEquipmentModes.UnitImage2)">
                            <Icon UseIcon="Trashcan" Title="Remove this Image" />
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="WorkflowEditItem">
                    <div class="Prompt">Unit Image 2:</div>
                    <div class="custom-file-upload">
                        @if (WorkflowStep is not null && WorkflowStep.RequireCamera.Equals(true))
                        {
                            <InputFile id="@UnitImage2.Id" OnChange="Unit2FileChanged" accept="image/*" capture="camera"></InputFile>
                        }
                        else
                        {
                            <InputFile id="@UnitImage2.Id" OnChange="Unit2FileChanged"></InputFile>
                        }
                        <label for="@UnitImage2.Id">
                            <span>
                                <i>(Required)</i>
                                <svg width="92px" height="92px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#FFFFFF"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M15 13H9" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round"></path> <path d="M12 10L12 16" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round"></path> <path d="M9.77778 21H14.2222C17.3433 21 18.9038 21 20.0248 20.2646C20.51 19.9462 20.9267 19.5371 21.251 19.0607C22 17.9601 22 16.4279 22 13.3636C22 10.2994 22 8.76721 21.251 7.6666C20.9267 7.19014 20.51 6.78104 20.0248 6.46268C19.3044 5.99013 18.4027 5.82123 17.022 5.76086C16.3631 5.76086 15.7959 5.27068 15.6667 4.63636C15.4728 3.68489 14.6219 3 13.6337 3H10.3663C9.37805 3 8.52715 3.68489 8.33333 4.63636C8.20412 5.27068 7.63685 5.76086 6.978 5.76086C5.59733 5.82123 4.69555 5.99013 3.97524 6.46268C3.48995 6.78104 3.07328 7.19014 2.74902 7.6666C2 8.76721 2 10.2994 2 13.3636C2 16.4279 2 17.9601 2.74902 19.0607C3.07328 19.5371 3.48995 19.9462 3.97524 20.2646C5.09624 21 6.65675 21 9.77778 21Z" stroke="#FFFFFF" stroke-width="1.5"></path> <path d="M19 10H18" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round"></path> </g></svg>
                            </span>
                        </label>
                    </div>
                </div>
            }
            break;

        case WFEquipmentModes.DataPlatePicture:

            @if (DataPlateImage!.ContentType is not null)
            {
                <div class="WorkflowImageMedia">
                    @* <div class="WorkflowPrompt">Data Plate Image:</div> *@
                    <div class="Image">
                        <img src="@DataPlateImage.Base64Version()" alt="DataPlate Photo">
                    </div>
                    <div class="ButtonWrapper">
                        <button type="button" class="Button" @onclick="() => DeleteImage(WFEquipmentModes.DataPlatePicture)">
                            <Icon UseIcon="Trashcan" Title="Remove this Image" />
                        </button>
                        <span>&nbsp;&nbsp;&nbsp;</span>
                        <button type="button" class="Button" @onclick="() => ProcessDPPhoto()">
                            <Icon UseIcon="Read" Title="Re-Read This DataPlate" />
                        </button>
                    </div>
                    @if (1 == 2 && ((bUseBluon) && DataPlateImage.Data is not null && DataPlateImage.Data.Length > 100))
                    {
                        <div>
                            <center>
                                <button class="dataplatelookup" @onclick="() => TryBluonNameplate()">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    Try Bluon Data for this @SelectedEquipment.Make
                                </button>
                            </center>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(DataPlateText))
                {
                    <div class="DataPlateNotes">
