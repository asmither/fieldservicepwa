                                <pre class="EqValue">@((MarkupString)PageBase.TextToHtml(Notes))</pre>
                            </div>
                            <button class="Button Transparent" @onclick="() => EditEquipment(WFEquipmentModes.Note)">
                                <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Edit" Title="Add/Edit NOTES" />
