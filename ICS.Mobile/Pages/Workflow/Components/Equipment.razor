                            <div class="Text">
                                Model: <span class="EqValue">&nbsp;@SelectedEquipment.Model</span>
                            </div>
                            <button class="Button Transparent" @onclick="() => EditEquipment(WFEquipmentModes.EnterModel)">
                                <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Edit" Title="Enter Model #" />
                            </button>
                        </div>

                        <div class="SingleLineWithButton">
                            <div class="Text">
                                Serial: <span class="EqValue">&nbsp;@SelectedEquipment.Serial</span>
                            </div>
                            <button class="Button Transparent" @onclick="() => EditEquipment(WFEquipmentModes.EnterSerialNumber)">
                                <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Edit" Title="Update Serial #" />
                            </button>
                        </div>

                        <div class="SingleLineWithButton">
                            <div class="Text">
                                Date Mfg: <span class="EqValue">&nbsp;@SelectedEquipment.MfgDate?.ToShortDateString()</span>
                            </div>
                            <button class="Button Transparent" @onclick="() => EditEquipment(WFEquipmentModes.ManufactureDate)">
                                <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Edit" Title="Set Mfg'd Date" />
                            </button>
                        </div>

                        <div class="SingleLineWithButton">
                            <div class="Text">
                                Installed: <span class="EqValue">&nbsp;@SelectedEquipment.InstallationDate?.Date.ToShortDateString()</span>
                            </div>
