                                    <img src="@UnitImage1!.Base64Version()" />
                                }
                            </div>
                            <button class="Button Transparent" @onclick="() => EditEquipment(WFEquipmentModes.UnitImage1)">
                                <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Edit" Title="Change Unit Image 1 Photo" />
                            </button>
                        </div>

                        <div class="DataPlateWithButton">
                            <div class="Text">UI2:</div>
                            <div class="Image">
                                @if (SelectedEquipment.UnitImage2FileName is not null)
                                {
                                    <img src="@UnitImage2!.Base64Version()" />
                                }
                            </div>
                            <button class="Button Transparent" @onclick="() => EditEquipment(WFEquipmentModes.UnitImage2)">
                                <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Edit" Title="Change Unit Image 2 Photo" />
                            </button>
                        </div>

                        <div class="DataPlateWithButton">
                            <div class="Text">DP:</div>
                            <div class="Image">
                                @if (SelectedEquipment.DataPlateFileName is not null)
                                {
                                    <img src="@DataPlateImage!.Base64Version()" />
                                }
                            </div>
                            <button class="Button Transparent" @onclick="() => EditEquipment(WFEquipmentModes.DataPlatePicture)">
                                <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Edit" Title="Change Dataplate Photo" />
                            </button>
                        </div>

