                                        </div>
                                        <button class="Button Transparent" @onclick="() => EditConsumable(consumable)">
                                            <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Edit" Title="@string.Concat("Update ", @consumable.Name)" />
                                        </button>
                                    </div>
                                }
                            }
                            <div class="SingleLineInfo">
                                Use the + button to add consumables.
                            </div>

                        </div>
                    </div>
                }


                @if (SelectedEquipment.Attributes.Count != 0 && IgnoreAttributes == false)
                {
                    <div class="EquipmentContainer">
                        <div class="Header">
                            <div class="Name SectionHeader">
                                Equip Attributes
                            </div>
                            @if (SelectedEquipment.HasMissingAttributesValues())
                            {
                                <button class="Button Transparent" @onclick="AutoPlayMissingAttributeValues">
                                    <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Repeat" Title="Collect Missing Data" />
                                </button>
                            }
                        </div>
                        <div class="Content">
                            @foreach (var attrib in SelectedEquipment.Attributes)
                            {
                                <div class="SingleLineWithButton">
                                    <div class="Text">
                                        @attrib.Name:&nbsp;
                                        <span class="EqValue">&nbsp;@attrib.Value</span>
                                    </div>
                                    <button class="Button Transparent" @onclick="() => EditAttribute(attrib)">
                                        <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Edit" Title="@string.Concat("Update ",attrib.Name)" />
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="EquipmentContainer">
                    <div class="InfoText">
                        Make corrections before proceeding.
                        <br />
                        Tap (Right Arrow) to SAVE equipment.
                    </div>

                </div>
            }

            break;
    }

    <Navigation NextDisabled="NextDisabled" PreviousDisabled="PreviousDisabled" OnNextClick="Next" OnPreviousClick="Previous"></Navigation>
    <ICS.Mobile.Components.ICSDialogBox @ref="DialogBox" />
}
else
{
    <ICSLoadingSpinner>
        <i class="bi bi-clock-fill"> </i>
    </ICSLoadingSpinner>
}

