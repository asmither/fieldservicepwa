                <ICSDismissable Message="@ErrorMessage"></ICSDismissable>
            </div>
            break;

        case WFEquipmentModes.EquipmentLocation:
            <div class="WorkflowEditItem">
                <ICSDismissable Message="@ErrorMessage"></ICSDismissable>
                <DataPicker Title="Equipment Location" DataList="@EquipmentLocations" ListId="locationArea" AllowAdditions="true" @bind-value="@EquipmentLocation"></DataPicker>
            </div>
            break;

        case WFEquipmentModes.EquipmentGroup:
            <div class="WorkflowEditItem">
                <ICSDismissable Message="@ErrorMessage"></ICSDismissable>
                <DataPicker Title="Group" DataList="@GroupListCopy" ListId="equipmentgroups" AllowAdditions="true" @bind-value="@EquipmentGroup"></DataPicker>
            </div>
            break;

        case WFEquipmentModes.IsRetired:

            <div class="WorkflowEditItem">
                <div class="Prompt">Is this unit now Retired?</div>
                <div class="Hints">Mark this unit as retired if no longer in active service.</div>
                <BooleanInput TruePrompt="Yes" FalsePrompt="No" @bind-Value="@IsRetired"></BooleanInput>
            </div>
            break;

        case WFEquipmentModes.Note:
            <div class="WorkflowEditItem">
                <div class="Prompt">Notes:</div>
                <div class="Hints">Share insights, access codes, etc.</div>
                <LargeTextInput @bind-value="@Notes"></LargeTextInput>
                <TinyPicker DataList="DataPlateList" Title="Add to Notes" @bind-Value="@Notes" AppendMode="true" />
            </div>

            break;

        case WFEquipmentModes.Consumables:

            if (SelectedConsumable is not null)
            {
                <h3>@SelectedConsumable.Name</h3>
                <div class="WorkflowEditItem">
                    <DataPicker Title="@SelectedConsumable.Name" ListId="@SelectedConsumable.Uid.ToString()" SuppressColumnTwo=true DataList="@SelectedConsumable.Options" @bind-Value="@SelectedConsumableValue"></DataPicker>
                </div>

                <div class="WorkflowEditItem">
                    <div class="Prompt">Quantity:</div>
                    <NumberInput @bind-Value="@SelectedConsumableQuantity"></NumberInput>
                </div>

                <div class="WorkflowEditItem">
                    <div class="Prompt">Optional Note:</div>
                    <LargeTextInput @bind-Value="@SelectedConsumableNote"></LargeTextInput>
                </div>
            }
            else
            {
                <div class="EquipmentContainer">
                    <div class="Header">
                        Current Consumables
                    </div>
