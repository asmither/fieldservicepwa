                            </div>
                            <button class="Button Transparent" @onclick="() => EditEquipment(WFEquipmentModes.EquipmentType)">
                                <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Edit" Title="Assign Equipment Type" />
                            </button>
