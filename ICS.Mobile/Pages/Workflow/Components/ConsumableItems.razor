@using ICS.Mobile.Components
@using ICS.Portal.Data.Queries.Models
@inherits WorkflowComponentsBasePage
@layout EmptyLayout
@if (Initialized)
{
    switch (Mode)
    {
        case Modes.ExistingListWithAdd:
            <div class="EquipmentContainer">
                <div class="Header">
                    Current Consumable Items
                    <button class="Button Transparent" @onclick="() => AddConsumableClick()">
                        <ICS.Mobile.Pages.Workflow.Components.Icon UseIcon="Add" Title="Add" />
                    </button>
                </div>
                <div class="Content">
                    @if (ConsumableItemsResults?.Count != 0)
                    {
                        @foreach (var ci in ConsumableItemsResults)
                        {
                            <div class="SingleLineWithButton">
                                <div class="Text">
                                    @ci.Name<span>: (@ci.Quantity)</span><br />
                                    Note: <span>@ci.Notes</span>
                                </div>
                                <button class="Button Transparent" @onclick="() => DeleteConsumableItem(ci)">
                                    <Icon UseIcon="Trashcan" Title="@(string.Concat("Delete ",ci.Name))" />
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="SingleLineInfo">No Consumable Items have been entered.</div>
                    }
                </div>
            </div>
            break;
        case Modes.SelectingCategory:
            @foreach (var attr in ConsumableAttributes)
            {
                if (SelectedCategory is not null && SelectedCategory.Id == attr.Id)
                {
                    <div class="Option Selected" @onclick="() => SetCategory(attr)">
                        <div class="Name">@attr.Name</div>
                        <i class="Image Selected bi-check2-square"></i>
                    </div>
                }
                else
                {
                    <div class="Option" @onclick="() => SetCategory(attr)">
                        <div class="Name">@attr.Name</div>
                        <i class="Image bi-square"></i>
                    </div>
                }
            }
            break;
        case Modes.SelectingItem:
            <DataPicker Title="Select Consumable Item" SuppressColumnTwo=false DataList="@ConsumableItemsList" @bind-Value="@SelectedConsumableValue"></DataPicker>
            @* @foreach (var ci in ConsumableItemsAvailable)
            {
                if (SelectedConsumableItem?.ConsumableId == ci.ConsumableId)
                {
                    <div class="Option Selected" @onclick="() => SetItem(ci)">
                        <div class="Name">@ci.Name</div>
                        <i class="Image Selected bi-check2-square"></i>
                    </div>
                }
                else
                {
                    <div class="Option" @onclick="() => SetItem(ci)">
                        <div class="Name">@ci.Name</div>
                        <i class="Image bi-square"></i>
                    </div>
                }
            } *@
            break;
        case Modes.SettingQuantityAndNotes:
            <h3>@SelectedConsumableItem?.Name</h3>
            <div class="WorkflowEditItem">
                <div class="Prompt">Quantity:</div>
                <NumberInput @bind-Value="@Quantity"></NumberInput>
            </div>

            <div class="WorkflowEditItem">
                <div class="Prompt">Optional Note:</div>
                <LargeTextInput @bind-Value="@Notes"></LargeTextInput>
            </div>

            break;
    }

    <CommonError Message="@ErrorMessage" />

    <Navigation NextDisabled="NextDisabled" PreviousDisabled="PreviousDisabled" OnNextClick="Next" OnPreviousClick="Previous"></Navigation>
}
else
{
    <ICSLoadingSpinner>
        <i class="bi-clock-fill"> </i>
    </ICSLoadingSpinner>
}