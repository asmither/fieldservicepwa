                    </g>
                </g>
            </g>
        </svg>
    }
    else if (UseIcon.Equals("Minus"))
    {
        <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <title>@Title</title>
            <g id="Complete">
                <g id="minus">
                    <g>
                        <line fill="none" stroke="#FFFFFF" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x1="20" x2="4" y1="12" y2="12" />
                    </g>
                </g>
            </g>
        </svg>
    }
    else if (UseIcon.Equals("Repeat"))
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" fill="currentColor" class="bi bi-repeat" viewBox="0 0 16 16">
            <title>Collect Missing Items</title>
