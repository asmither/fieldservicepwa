@page "/directory"
@inherits ICS.Mobile.Pages.PageBase

@using ICS.Mobile.Components
@* @using ICS.Mobile.Components.ScratchPad *@

<PageHeaderBasic Title="Company Directory" Icon="bi-people">
    <RoundButtonGreen Icon="bi-arrow-left" OnClick="OnCloseClick" />
</PageHeaderBasic>

<svg style="display:none">
    <symbol id="email" fill="currentColor" width="50" height="50" viewBox="0 0 1920 1920" xmlns="http://www.w3.org/2000/svg">
        <title>Send Email</title>
        <path d="M1920 428.266v1189.54l-464.16-580.146-88.203 70.585 468.679 585.904H83.684l468.679-585.904-88.202-70.585L0 1617.805V428.265l959.944 832.441L1920 428.266ZM1919.932 226v52.627l-959.943 832.44L.045 278.628V226h1919.887Z" fill-rule="evenodd" />
    </symbol>
    <symbol id="phone" height="44" width="44" viewBox="0 0 512 512" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xml:space="preserve">
    <title>Dial Telephone</title>
    <g>
    <path fill="currentColor" d="M403.854,409.684c-17.68-14.106-72.76-41.247-86.349-44.375c-13.562-3.154-29.98,9.962-34.501,26.248
                c-4.547,16.295-13.027,14.753-13.027,14.753s-32.67-12.003-92.429-71.534c-59.769-59.549-71.85-92.175-71.85-92.175
                s-1.595-8.48,14.692-13.089c16.252-4.564,29.314-21.035,26.125-34.598c-3.171-13.562-30.532-68.563-44.69-86.165
                c-14.192-17.601-41.606-8.524-47.633-4.135C48.13,108.987-15.581,149.49,3.58,224.072
                c19.186,74.592,60.346,134.264,105.579,179.348c45.242,45.066,105.062,85.998,179.715,104.904
                c74.644,18.915,114.919-44.944,119.274-51.006C412.51,451.273,421.481,423.816,403.854,409.684z" />
    <path fill="currentColor" d="M247.023,189.177c9.9,4.854,25.644,13.86,43.893,32.1c18.25,18.25,27.247,33.993,32.1,43.884
                c5.099,10.4,8.866,12.494,11.915,11.784c5.029-1.166,6.702-2.515,7.167-13.001c0.385-8.936-3.89-35.588-31.076-62.773
                c-27.186-27.186-53.846-31.452-62.764-31.067c-10.496,0.447-11.828,2.129-12.992,7.175
                C234.555,180.311,236.623,184.087,247.023,189.177z" />
    <path fill="currentColor" d="M262.95,84.247c-12.808-0.009-16.042,7.92-16.428,10.995c-0.788,6.212,3.794,11.249,13.308,13.974
                c10.881,3.11,53.986,16.935,90.099,53.048c36.122,36.113,49.956,79.226,53.057,90.107c2.716,9.506,7.744,14.08,13.964,13.3
                c3.092-0.369,11.012-3.61,10.995-16.418c0.009-10.137-6.186-63.22-53.986-111.038C326.17,90.423,273.06,84.237,262.95,84.247z" />
    <path fill="currentColor" d="M437.304,74.889C368.836,6.422,296.602,0.526,284.187,0.201c-15.157-0.385-21.167,6.414-21.158,13.387
                c-0.009,5.94,6.08,12.046,15.139,14.377c13.597,3.486,67.495,11.976,130.784,75.266c63.307,63.29,71.78,117.197,75.284,130.803
                c2.322,9.041,8.437,15.139,14.368,15.139c6.982,0,13.781-6.002,13.378-21.149C511.667,215.601,505.771,143.366,437.304,74.889z" />
        </g>
    </symbol>
</svg>
<symbol id="sms" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
    <title>Send Text</title>
    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zM7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z" />
</symbol>

@if (Initialized)
{

        @* <ScratchPadOverlay @ref="scratchPadRef" CurrentUserId="@CurrentUserId" /> *@
    @* <ScratchPadFab CurrentUserId="@CurrentUserId" /> *@

    <div class="directory-container">
        <div class="search-section">
            <div class="search-field">
                @if (!string.IsNullOrEmpty(SearchValue) && DirectoryFiltered != null && DirectoryFiltered.Count > 0)
                {
                    <span class="search-icon">@DirectoryFiltered.Count</span>
                }
                else
                {
                    <svg class="search-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" @onclick="FilterReset">
                        <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor" />
                    </svg>
                }
                <input type="text"
                       id="search"
                       class="search-input"
                       placeholder="Search name, city, or zone..."
                       @bind="SearchValue"
                       @bind:event="oninput"
                       @bind:after="@(()=>FilterSearch())" />
                @if (!string.IsNullOrEmpty(SearchValue))
                {
                    <button class="clear-button" @onclick="FilterReset" title="Clear search">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                }

            </div>
            <!-- A-Z Letter Strip -->
            <div class="letter-strip-container">
                <div class="letter-strip">
                    <button class="letter-btn @(ActiveLetter == null ? "active" : "")"
                            @onclick="() => FilterSearch(string.Empty)">
                        ALL
                    </button>
                    @foreach (var letter in AvailableLetters)
                    {
                        <button class="letter-btn @(ActiveLetter == letter ? "active" : "") @(HasDudesForLetter(letter) ? "" : "disabled")"
                                @onclick="() => FilterSearch(letter)"
                                disabled="@(!HasDudesForLetter(letter))">
                            @letter
                        </button>
                    }
                    <button class="letter-btn @(ActiveLetter == "" ? "active" : "") @(HasDudesForLetter("") ? "" : "disabled")"
                            @onclick='() => FilterSearch("")'
                            disabled="@(!HasDudesForLetter(""))">
                        #
                    </button>
                </div>
            </div>
            @if (1 == 2 && !string.IsNullOrEmpty(SearchValue) && DirectoryFiltered != null)
            {
                <div class="search-info">
                    <span class="result-count">@DirectoryFiltered.Count</span>
                    <span class="result-label">@(DirectoryFiltered.Count == 1 ? "result" : "results")</span>
                </div>
            }
        </div>


        <div class="main-content">
            <div class="directory-list">
                @if (DirectoryFiltered is not null && DirectoryFiltered.Count > 0)
                {
                    @foreach (var employee in DirectoryFiltered!)
                    {
                        <div id="@employee.LinkLetter" class="employee-card">
                            @if (employee.LinkLetter?.Length == 1)
                            {
                                <div class="letter-indicator">@employee.LinkLetter.ToUpper()</div>
                            }
                            <div class="card-content">
                                <div class="employee-details">
                                    <h3 class="employee-name">
                                        @employee.LastName, @employee.FirstName
                                    </h3>
                                    @if (!string.IsNullOrEmpty(employee.Title))
                                    {
                                        <span class="employee-role">@employee.Title</span>
                                    }
                                    @if (!string.IsNullOrEmpty(employee.Phone))
                                    {
                                        <span class="meta-icon"><i class="bi bi-telephone" aria-hidden="true"></i></span>
                                        <span class="phone-number">@ICS.Portal.Data.Custom.GeneralFunctions.FormatPhoneNumber(employee.Phone)</span>
                                    }
                                    <div class="employee-meta">
                                        @if (!string.IsNullOrEmpty(employee.City) || !string.IsNullOrEmpty(employee.State))
                                        {
                                            <span class="location">
                                                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                                @if (!string.IsNullOrEmpty(employee.City))
                                                {
                                                    @employee.City
                                                }
                                                @if (!string.IsNullOrEmpty(employee.City) && !string.IsNullOrEmpty(employee.State))
                                                {
                                                    @string.Concat(", ", employee.State)
                                                }
                                                else if (!string.IsNullOrEmpty(employee.State))
                                                {
                                                    @employee.State
                                                }
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(employee.ZoneName))
                                        {
                                            <span class="zone"> @employee.ZoneName</span>
                                        }

                                    </div>
                                </div>
                                <div class="contact-buttons">

                                    @if (employee.Phone is not null)
                                    {
                                        <a href="tel:@employee.Phone" class="contact-btn phone-btn">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 44 44">
                                                <use xlink:href="#phone"></use>
                                            </svg>
                                            <span class="btn-label"> Call </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="contact-btn disabled">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 44 44">
                                                <use xlink:href="#phone"></use>
                                            </svg>
                                            <span class="btn-label"> Call </span>
                                        </span>
                                    }
                                    @if (employee.Phone is not null)
                                    {
                                        <span> &nbsp; </span>
                                        <a href="sms:@employee.Phone" class="contact-btn sms-btn">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                                                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zM7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z" />
                                            </svg>
                                            <span class="btn-label"> Text </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span> &nbsp; </span>
                                        <span class="contact-btn disabled">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                                                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zM7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z" />
                                            </svg>
                                            <span class="btn-label"> Text </span>
                                        </span>
                                    }
                                    <span> &nbsp; </span>
                                    @if (employee.Email is not null)
                                    {
                                        <a href="mailto:@employee.Email" class="contact-btn email-btn">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 40">
                                                <use xlink:href="#email"></use>
                                            </svg>
                                            <span class="btn-label"> Email </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="contact-btn disabled">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 40">
                                                <use xlink:href="#email"></use>
                                            </svg>
                                            <span class="btn-label"> Email </span>
                                        </span>
                                    }
                                    
                                    @if (employee is not null)
                                    {
                                        <span> &nbsp; </span>
                                        <span class="contact-btn copy-btn" @onclick="() => CopyToClipboard(employee)">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                                                <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
                                            </svg>
                                            <span class="btn-label"> Copy </span>
                                        </span>
                                    }

                                </div>
                            </div>
                        </div>
                    }
                }
                else if (DirectoryFiltered is not null)
                {
                    <div class="empty-state">
                        <div class="empty-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
                        <h3>No matches found</h3>
                        <p>Try adjusting your search criteria</p>
                    </div>
                }

            </div>

            @*  <!-- Rolodex-Style Alphabet Navigation -->
            @if (ShowAlphabetNav)
            {
                    <div class="rolodex-nav">
                        <div class="rolodex-container">
                            <button class="close-nav-button" @onclick="(() => ShowAlphabetNav = false)" title="Hide alphabet navigation">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                            </button>
                            @if (string.IsNullOrEmpty(SearchValue))
                            {
                                @foreach (var item in Links)
                                {
                                    <div class="rolodex-tab @(item.Value ? "active" : "inactive")">
                                        <button class="tab-button"
                                                @onclick="@(async ()=>await FilterSearch(item.Key.ToUpper()))"
                                                disabled="@(!item.Value)">
                                            <span class="tab-letter">@item.Key.ToUpper()</span>
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="rolodex-reset">
                                    <button class="reset-button" @onclick="FilterReset">
                                        <span class="reset-icon"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></span>
                                        <span class="reset-text">Clear</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

            }
            else
            {
                <button class="show-nav-button" @onclick="(() => ReshowAlphaNav())" title="Show alphabet navigation">
                    &nbsp;
                </button>
            }
         *@
        </div>
    </div>
}
else
{
    <ICSLoadingSpinner>
        <i class="bi-clock-fill"> </i>
        @* <span>Loading</span> *@
    </ICSLoadingSpinner>
}

<style>
    /* Local aliases mapped onto the design tokens (scoped: must not clobber
       the global --text-* / --surface-* tokens). */
    .directory-container {
        --bg-primary: var(--surface-app);
        --bg-secondary: var(--surface-raised-subtle);
        --bg-card: var(--surface-card);
        --accent-primary: var(--accent);
        --accent-secondary: var(--accent-strong);
        --border-color: rgba(255, 255, 255, 0.09);
        --shadow-color: rgba(0, 0, 0, 0.3);
    }

    /* Container Layout */
    .directory-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 80px);
    @* background: var(--bg-primary); *@
        padding: 1rem;
        color: var(--text-primary);
    }

    /* Search Section */
    .search-section {
        margin-bottom: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }

    .search-field {
        display: flex;
        align-items: center;
        background: var(--surface-input);
        border: var(--border-hairline);
        border-radius: var(--radius-full);
        min-height: var(--touch-target);
        padding: 0.5rem 1.25rem;
        width: 100%;
        max-width: 500px;
        transition: border-color var(--motion-fast) ease;
    }

        .search-field:focus-within {
            border-color: var(--accent);
        }

    .search-icon {
        color: var(--text-muted);
        margin-right: 0.75rem;
        flex-shrink: 0;
    }

    .search-input {
        flex: 1;
        background: transparent;
        border: none;
        color: var(--text-primary);
        font-size: var(--text-lg);
        outline: none;
    }

        .search-input::placeholder {
            color: var(--text-muted);
        }

    .clear-button {
        background: var(--surface-raised-subtle);
        border: none;
        color: var(--text-primary);
        border-radius: var(--radius-full);
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: var(--text-sm);
        transition: background-color var(--motion-fast) ease;
    }

        .clear-button:hover {
            background: rgba(255, 255, 255, 0.18);
        }

    .search-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .result-count {
        font-weight: var(--weight-bold);
        color: var(--text-primary);
        font-size: var(--text-lg);
    }

    .result-label {
        color: var(--text-muted);
    }

    /* Main Content */
    .main-content {
        display: flex;
        gap: 1.5rem;
        flex: 1;
        overflow: hidden;
    }

    /* Directory List */
    .directory-list {
        flex: 1;
        overflow-y: auto;
        padding-right: 0.5rem;
    }

        .directory-list::-webkit-scrollbar {
            width: 8px;
        }

        .directory-list::-webkit-scrollbar-track {
            background: var(--bg-secondary);
            border-radius: 4px;
        }

        .directory-list::-webkit-scrollbar-thumb {
            background: var(--accent-primary);
            border-radius: 4px;
        }

    /* Employee Card - Reduced padding */
    .employee-card {
        position: relative;
        margin-bottom: var(--space-2);
        background: var(--surface-card);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--elevation-1);
        transition: border-color var(--motion-fast) ease;
        border: var(--border-hairline);
    }

        .employee-card:hover {
            border-color: var(--accent);
        }

    .letter-indicator {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2.5rem;
        background: var(--accent-strong);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-lg);
        font-weight: var(--weight-bold);
        color: var(--text-on-accent);
    }

    .card-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem;
        padding-left: 3.5rem;
    }

    .employee-card:not(:has(.letter-indicator)) .card-content {
        padding-left: 0.75rem;
    }

    .employee-details {
        flex: 1;
        min-width: 0;
    }

    .employee-name {
        font-size: var(--text-lg);
        font-weight: var(--weight-semibold);
        margin: 0 0 0.15rem 0;
        color: var(--text-primary);
        line-height: var(--leading-tight);
    }

    .employee-role {
        display: inline-block;
        font-size: var(--text-sm);
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.08);
        padding: 0.15rem 0.5rem;
        border-radius: var(--radius-sm);
        margin-bottom: 0.25rem;
    }

    .employee-meta {
        display: flex;
        gap: 0.90rem;
        margin-top: 0.25rem;
        font-size: var(--text-sm);
        color: var(--text-muted);
    }

    .location {
        display: flex;
        align-items: center;
        font-size: var(--text-sm);
        gap: 0.2rem;
    }

    .zone {
        padding: 0.15rem 0.4rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
    }

    /* Contact Buttons - More compact */
    .contact-buttons {
        display: flex;
        gap: 0.4rem;
    }

    .contact-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.15rem;
        padding: 0.35rem;
        background: var(--surface-raised-subtle);
        border: var(--border-hairline);
        color: var(--text-secondary);
        border-radius: var(--radius-md);
        text-decoration: none;
        transition: background-color var(--motion-fast) ease;
        min-width: var(--touch-target);
        min-height: var(--touch-target);
    }

        .contact-btn svg {
            width: 20px;
            height: 20px;
        }

    .btn-label {
        font-size: var(--text-xs);
        color: var(--text-secondary);
        text-transform: uppercase;
        font-weight: var(--weight-medium);
    }

    .contact-btn:hover:not(.disabled),
    .contact-btn:active:not(.disabled) {
        background: rgba(255, 255, 255, 0.18);
    }

    .contact-btn.disabled {
        opacity: 0.3;
        cursor: not-allowed;
        background: transparent;
    }

    /* Rolodex Navigation */
    .rolodex-nav {
        width: 80px;
        position: relative;
    }

    .rolodex-container {
        position: sticky;
        top: 0;
        height: fit-content;
        max-height: calc(100vh - 150px);
        overflow-y: auto;
        background: linear-gradient(180deg, var(--bg-secondary), var(--bg-card));
        border-radius: 40px;
        padding: 2rem 0.5rem 0.5rem 0.5rem;
        box-shadow: inset 0 2px 8px var(--shadow-color), 0 4px 12px var(--shadow-color);
        position: relative;
    }

    /* Close Navigation Button */
    .close-nav-button {
        position: absolute;
        top: 0.25rem;
        right: 0.25rem;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--accent-primary);
        border: none;
        color: white;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        z-index: 10;
    }

        .close-nav-button:hover {
            background: var(--accent-secondary);
            transform: scale(1.1);
        }

    /* Show Navigation Button */
    .show-nav-button {
        position: sticky;
        top: 50%;
        transform: translateY(-50%);
        padding: 0.75rem 0.5rem;
    @* background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary)); *@
        background: linear-gradient(135deg, #c4e94512, #ef7d76);
        border: none;
        border-radius: 8px 0 0 8px;
        color: white;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(233, 69, 96, 0.3);
        writing-mode: vertical-rl;
        text-orientation: mixed;
    }

        .show-nav-button:hover {
            transform: translateY(-50%) translateX(-2px);
            box-shadow: 0 4px 12px rgba(233, 69, 96, 0.4);
        }

    .rolodex-tab {
        position: relative;
        margin-bottom: -8px;
        transition: all 0.2s ease;
    }

        .rolodex-tab:hover {
            z-index: 10;
            margin-bottom: -4px;
        }

    .tab-button {
        width: 100%;
        height: 45px;
        background: linear-gradient(145deg, #2a2a3e, #1a1a2e);
        border: 2px solid var(--border-color);
        border-radius: 8px 24px 24px 8px;
