<style>

    body {
        padding: env(safe-area-inset-top) 1rem 0.6rem 0.6rem;
        margin: 0;
        margin-top: 1rem;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        font-family: var(--PrimaryFonts);
    }

    pre {
        white-space: pre-wrap;
        word-wrap: break-word;
        font-family: 'SF Mono', SFMono-Regular, ui-monospace, 'DejaVu Sans Mono', Menlo, Consolas, monospace;
    }

    a:link {
        color: var(--accent-soft);
    }

    a:hover {
        color: var(--accent);
    }

    a:visited {
        color: var(--accent-soft);
    }

    a:active {
        color: var(--accent);
    }

    .HomeActionButtonsContainer {
        margin-top: var(--space-4);
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto;
        grid-row-gap: var(--space-3);
        grid-column-gap: var(--space-3);
        grid-template-areas:
            "MyDispatches         MyDispatches"
            "StartDay             EndDay"
            "TakeFive             Injury"
            "TimeClock            TimeClock"
            "Directory            Directory"
            "Calculator           Calculator";
    }

        .HomeActionButtonsContainer .ActionButtonFull,
        .HomeActionButtonsContainer .ActionButtonFullHH,
        .HomeActionButtonsContainer .ActionButtonHalf {
            display: grid;
            align-items: center;
            align-self: center;
            background: var(--surface-card);
            border: var(--border-hairline);
            border-radius: var(--radius-lg);
            box-shadow: var(--elevation-1);
            color: var(--text-primary);
            min-height: var(--touch-target);
            cursor: pointer;
            transition: transform 120ms ease, background-color 120ms ease;
        }

            .HomeActionButtonsContainer .ActionButtonFull:active,
            .HomeActionButtonsContainer .ActionButtonFullHH:active,
            .HomeActionButtonsContainer .ActionButtonHalf:active {
                transform: scale(0.98);
                background: var(--surface-raised-subtle);
            }

        /* Wave mode: solid hero so it doesn't wash out over the art. */
        :root.bg-wave:not([data-theme="dark"]) .HomeActionButtonsContainer .ActionButtonFull {
            background: rgba(13, 62, 118, 0.9);
        }

        /* Hero card — the primary destination gets an accent-tinted surface. */
        .HomeActionButtonsContainer .ActionButtonFull {
            grid-template-rows: auto auto;
            grid-template-areas:
                "Title"
                "Count";
            justify-items: center;
            row-gap: var(--space-1);
            padding: var(--space-6) var(--space-4);
            background: rgba(41, 148, 208, 0.12);
            border: 1px solid rgba(41, 148, 208, 0.35);
        }

            .HomeActionButtonsContainer .ActionButtonFull .Title {
                grid-area: Title;
                font-size: var(--text-sm);
                font-weight: var(--weight-semibold);
                letter-spacing: .06em;
                text-transform: uppercase;
                color: var(--text-secondary);
            }

            .HomeActionButtonsContainer .ActionButtonFull .Count {
                grid-area: Count;
                font-size: var(--text-display);
                font-weight: var(--weight-bold);
                line-height: 1.1;
                color: var(--accent-soft);
            }

            .HomeActionButtonsContainer .ActionButtonFull .CountEmpty {
                grid-area: Count;
                font-size: var(--text-lg);
                font-weight: var(--weight-medium);
                color: var(--accent-soft);
            }

            .HomeActionButtonsContainer .ActionButtonFull.MyDispatches {
                grid-area: MyDispatches;
            }

            .HomeActionButtonsContainer .ActionButtonFull.ChecklistsInProgress {
                grid-area: ChecklistsInProgress;
            }

        /* Full-width destinations read as tappable rows: leading icon,
           left-aligned label, trailing chevron, 64px target. */
        .HomeActionButtonsContainer .ActionButtonFullHH {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            min-height: 4rem;
            padding: var(--space-3) var(--space-4);
            text-align: left;
        }

            .HomeActionButtonsContainer .ActionButtonFullHH .Lead {
                font-size: 1.5rem;
                line-height: 1;
                color: var(--accent-soft);
            }

            .HomeActionButtonsContainer .ActionButtonFullHH .Title {
                flex: 1;
                font-size: var(--text-lg);
                font-weight: var(--weight-medium);
            }

            .HomeActionButtonsContainer .ActionButtonFullHH .Chevron {
                font-size: var(--text-lg);
                line-height: 1;
                color: var(--text-muted);
            }

            .HomeActionButtonsContainer .ActionButtonFullHH .Tagline {
                display: inline-block;
                margin-left: var(--space-2);
                padding: 0.15em 0.5em;
                font-size: var(--text-xs);
                font-weight: var(--weight-bold);
                border-radius: var(--radius-full);
                color: var(--text-on-accent);
                background-color: var(--status-danger);
            }

            .HomeActionButtonsContainer .ActionButtonFullHH.TimeClock {
                grid-area: TimeClock;
            }


            .HomeActionButtonsContainer .ActionButtonFullHH.NewDispatch {
                grid-area: NewDispatch;
            }

            .HomeActionButtonsContainer .ActionButtonFullHH.Calculator {
                grid-area: Calculator;
            }

            .HomeActionButtonsContainer .ActionButtonFullHH.Directory {
                grid-area: Directory;
            }

            .HomeActionButtonsContainer .ActionButtonFullHH.Bluon {
                grid-area: Bluon;
            }



        .HomeActionButtonsContainer .ActionButtonHalf {
            grid-template-rows: auto auto;
            grid-template-areas:
                "Image"
                "Title";
            justify-items: center;
            row-gap: var(--space-2);
            padding: var(--space-4) var(--space-3);
        }

            .HomeActionButtonsContainer .ActionButtonHalf .ImageContainer {
                height: 3rem;
                width: 100%;
                grid-area: Image;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .HomeActionButtonsContainer .ActionButtonHalf .ImageContainer .Image {
                    height: 2.75rem;
                    width: 2.75rem;
                }

                .HomeActionButtonsContainer .ActionButtonHalf .ImageContainer .Icon {
                    font-size: 2.25rem;
                    line-height: 1;
                    color: var(--accent-soft);
                }

            /* Per-tile icon colors, echoing the original colorful glyphs
               (sun/moon/clock/heart) but from the token palette. */
            .HomeActionButtonsContainer .ActionButtonHalf.StartDay .ImageContainer .Icon {
                color: var(--status-warning);
            }

            .HomeActionButtonsContainer .ActionButtonHalf.EndDay .ImageContainer .Icon {
                color: var(--accent-soft);
            }

            .HomeActionButtonsContainer .ActionButtonHalf.TakeFive .ImageContainer .Icon {
                color: var(--status-success);
            }

            .HomeActionButtonsContainer .ActionButtonHalf.Injury .ImageContainer .Icon {
                color: var(--status-danger);
            }

            .HomeActionButtonsContainer .ActionButtonHalf .Title {
                grid-area: Title;
                font-size: var(--text-base);
                font-weight: var(--weight-medium);
                align-self: start;
                line-height: var(--leading-tight);
            }

            .HomeActionButtonsContainer .ActionButtonHalf.StartDay {
                grid-area: StartDay;
            }

            .HomeActionButtonsContainer .ActionButtonHalf.EndDay {
                grid-area: EndDay;
            }

            .HomeActionButtonsContainer .ActionButtonHalf.TakeFive {
                grid-area: TakeFive;
            }

            .HomeActionButtonsContainer .ActionButtonHalf.Injury {
                grid-area: Injury;
            }

    .HomeNewsContainer .CategoryTitle, .HomeGoalsContainer .CategoryTitle {
        font-size: var(--text-sm);
        font-weight: var(--weight-semibold);
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin: 0 0 var(--space-2);
    }

    .HomeGoalsContainer {
        margin-top: var(--space-6);
        background: var(--surface-card);
        border: var(--border-hairline);
        border-radius: var(--radius-lg);
        box-shadow: var(--elevation-1);
        padding: var(--space-4);
    }

    .HomeGoalItem {
        padding-top: 1rem;
        display: grid;
        grid-template-columns: auto 6rem;
        grid-template-rows: 3rem 2rem 2rem;
        grid-template-areas:
            "Title Target"
            "SubTitle SubTitle"
            "Graphic Graphic"
    }

        .HomeGoalItem .Title {
            grid-area: Title;
            font-size: var(--text-lg);
            font-weight: var(--weight-semibold);
            color: var(--text-primary);
            margin-top: var(--space-3);
        }

        .HomeGoalItem .Target {
            grid-area: Target;
            text-align: right;
            font-feature-settings: "dgsp";
            align-self: center;
            font-size: var(--text-sm);
            color: var(--text-muted);
            margin-top: var(--space-8);
        }

        .HomeGoalItem .SubTitle {
            grid-area: SubTitle;
            font-size: var(--text-sm);
            font-weight: var(--weight-medium);
        }

        .HomeGoalItem .Graphic {
            height: 2rem;
            grid-area: Graphic;
            display: grid;
            grid-template-columns: auto 6rem;
            grid-template-rows: auto;
            grid-template-areas:
                "Slider Value";
            align-items: center;
        }

            .HomeGoalItem .Graphic .Slider {
                grid-area: Slider;
                accent-color: var(--accent);
                pointer-events: none;
            }

            .HomeGoalItem .Graphic .Icon {
                grid-area: Value;
                width: 6rem;
            }


            .HomeGoalItem .Graphic .Value {
                grid-area: Value;
                text-align: center;
                font-size: var(--text-xs);
                font-weight: var(--weight-bold);
            }


    .HomeNewsContainer {
        margin-top: var(--space-6);
        background: var(--surface-card);
        border: var(--border-hairline);
        border-radius: var(--radius-lg);
        box-shadow: var(--elevation-1);
        padding: var(--space-4);
    }

    .HomePageNewsItem {
        padding-top: var(--space-6);
        display: grid;
        grid-template-rows: auto auto;
        grid-template-areas:
            "Date"
            "Image"
            "Text";
    }

        .HomePageNewsItem .Date {
            grid-area: Date;
            margin-bottom: var(--space-1);
            font-size: var(--text-lg);
            font-weight: var(--weight-semibold);
            color: var(--text-primary);
        }

        .HomePageNewsItem .Text {
            grid-area: Text;
            font-size: var(--text-base);
            color: var(--text-secondary);
        }

        .HomePageNewsItem .NewsImg {
            grid-area: Image;
            width: 96%;
            max-width: 560px;
            margin: 0 auto;
            padding: var(--space-2);
            box-shadow: var(--elevation-1);
            border: var(--border-hairline);
            border-radius: var(--radius-md);
            overflow: hidden;
            background-color: transparent;
            margin-top: var(--space-1);
            margin-bottom: var(--space-3);
        }

            .HomePageNewsItem .NewsImg img {
                width: 100%;
                height: auto;
                display: block;
                margin: 0 auto;
            }

</style>