<style>

    body {
        padding: env(safe-area-inset-top) 0.6rem 0.6rem 0.6rem;
        margin: 0;
        margin-top: 1rem;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }

    /* Mobile-First CSS */
    .bodystyle {
        font-size: var(--text-sm);
    }

    /* Token bridge — map Bootstrap onto the ICS design tokens (guide rule 7). */
    .container-fluid {
        color: var(--text-primary);
        --bs-body-color: var(--text-primary);
        --bs-body-color-rgb: 255, 255, 255;
        --bs-body-bg: var(--surface-input);
        --bs-emphasis-color: var(--text-primary);
        --bs-heading-color: var(--text-primary);
        --bs-secondary-color: var(--text-muted);
        --bs-secondary-bg: var(--surface-raised-subtle);
        --bs-tertiary-color: var(--text-muted);
        --bs-tertiary-bg: var(--surface-raised-subtle);
        --bs-border-color: rgba(255, 255, 255, 0.15);
        --bs-border-color-translucent: rgba(255, 255, 255, 0.09);
        --bs-link-color: var(--accent-soft);
        --bs-link-hover-color: var(--accent);
        --bs-primary-rgb: 41, 148, 208; /* --brand-500 */
        --bs-box-shadow-sm: var(--elevation-1);
    }

        .container-fluid .card {
            --bs-card-bg: var(--surface-card);
            --bs-card-border-color: rgba(255, 255, 255, 0.09);
            --bs-card-cap-bg: rgba(255, 255, 255, 0.04);
            --bs-card-border-radius: var(--radius-md);
        }

        .container-fluid .table {
            --bs-table-bg: transparent;
            --bs-table-color: var(--text-primary);
            --bs-table-border-color: rgba(255, 255, 255, 0.15);
        }

        .container-fluid .table-light {
            --bs-table-bg: rgba(255, 255, 255, 0.08);
            --bs-table-color: var(--text-primary);
            --bs-table-border-color: rgba(255, 255, 255, 0.15);
        }

        .container-fluid .bg-light {
            --bs-bg-opacity: 0.08;
        }


        .container-fluid .card-title.text-dark {
            --bs-dark-rgb: 255, 255, 255; /* titles sit on dark-glass cards now */
        }

        .container-fluid .nav-pills {
            --bs-nav-pills-link-active-bg: var(--brand-700); /* 4.5:1 with white at small sizes */
            --bs-nav-link-color: var(--text-secondary);
            --bs-nav-pills-border-radius: var(--radius-md);
        }

    /* Calculator Card Styles */
    .calc-card {
        transition: border-color var(--motion-fast) ease;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .calc-card:hover {
            border-color: var(--accent);
        }

        .calc-card .card-body {
            min-height: 160px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

    /* System Category Styling (colored strip retired per anti-slop addendum) */
    .system-category {
        border-left: none;
    }

    /* Cost Highlight */
    .cost-highlight {
        background: rgba(255, 255, 255, 0.08);
        font-weight: var(--weight-semibold);
    }

    /* Table Responsive */
    .table-responsive {
        font-size: var(--text-xs);
    }

    /* Card Headers */
    .card-header {
        font-weight: var(--weight-semibold);
    }

    /* Navigation Pills */
    .nav-pills .nav-link {
        font-size: var(--text-sm);
        padding: var(--space-2) var(--space-3);
    }

    /* Badge Positioning */
    .position-relative .badge {
        top: 5px;
        right: 5px;
    }


    /* Link Styling */
    a.text-decoration-none:hover .card {
        text-decoration: none;
    }
</style>

