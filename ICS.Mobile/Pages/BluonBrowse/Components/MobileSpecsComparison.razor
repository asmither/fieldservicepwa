@namespace ICS.Mobile.Pages.BluonBrowse.Components
@using ICS.Portal.Data.Custom
@using static ICS.Portal.Data.Custom.BluonBase

<div class="mobile-specs-comparison">
    @if (OriginalSpecs != null && AlternativeSpecs != null)
    {
        var origDict = OriginalSpecs.ToDictionary();
        var altDict = AlternativeSpecs.ToDictionary();
        var keySpecs = GetKeySpecifications(origDict, altDict);

        @if (keySpecs.Any())
        {
            <div class="comparison-header">
                <span class="comparison-title">Key Differences</span>
            </div>

            @foreach (var spec in keySpecs)
            {
                <div class="spec-comparison-row">
                    <div class="spec-name">@FormatSpecName(spec.Key)</div>
                    <div class="spec-values">
                        <div class="original-value">
                            <span class="value-label">Original:</span>
                            <span class="value">@FormatValue(spec.Value.Original)</span>
                        </div>
                        <div class="alternative-value @GetComparisonClass(spec.Value.Original, spec.Value.Alternative)">
                            <span class="value-label">Alternative:</span>
                            <span class="value">@FormatValue(spec.Value.Alternative)</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-differences">
                <i class="bi bi-check-circle"></i>
                <span>Key specifications match</span>
            </div>
        }
    }
    else if (AlternativeSpecs != null)
    {
        var altDict = AlternativeSpecs.ToDictionary();
        var importantSpecs = GetImportantSpecs(altDict);

        @if (importantSpecs.Any())
        {
            <div class="comparison-header">
                <span class="comparison-title">Key Specifications</span>
            </div>

            @foreach (var spec in importantSpecs)
            {
                <div class="spec-row">
                    <span class="spec-name">@FormatSpecName(spec.Key):</span>
                    <span class="spec-value">@FormatValue(spec.Value)</span>
                </div>
            }
        }
    }
</div>

<style>
    .mobile-specs-comparison {
        font-size: 0.75rem;
    }

    .comparison-header {
        margin-bottom: 0.5rem;
        padding-bottom: 0.25rem;
        border-bottom: 1px solid #e9ecef;
    }

    .comparison-title {
        font-weight: 600;
        color: var(--bluon-dark);
        font-size: 0.75rem;
    }

    .spec-comparison-row {
        margin-bottom: 0.75rem;
        padding: 0.5rem;
        background: white;
        border-radius: 4px;
        border: 1px solid #e9ecef;
    }

    .spec-name {
        font-weight: 600;
        color: var(--bluon-dark);
        margin-bottom: 0.375rem;
        font-size: 0.75rem;
    }

    .spec-values {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .original-value,
    .alternative-value {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.25rem 0.5rem;
        border-radius: 3px;
        background: #f8f9fa;
    }

    .original-value {
        border-left: 3px solid #6c757d;
    }

    .alternative-value {
        border-left: 3px solid var(--bluon-primary);
    }

        .alternative-value.better {
            background: #d4edda;
            border-left-color: var(--bluon-success);
        }

        .alternative-value.worse {
            background: #f8d7da;
            border-left-color: #dc3545;
        }

        .alternative-value.different {
            background: #fff3cd;
            border-left-color: #ffc107;
        }

    .value-label {
        font-size: 0.625rem;
        color: #6c757d;
        font-weight: 500;
    }

    .value {
        font-weight: 600;
        color: var(--bluon-dark);
        font-size: 0.75rem;
    }

    .spec-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.375rem 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .spec-row:last-child {
            border-bottom: none;
        }

        .spec-row .spec-name {
            margin-bottom: 0;
            flex: 1;
            min-width: 0;
        }

        .spec-row .spec-value {
            font-weight: 600;
            color: var(--bluon-dark);
            margin-left: 0.5rem;
            text-align: right;
        }

    .no-differences {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        padding: 0.75rem;
        color: var(--bluon-success);
        background: #d4edda;
        border-radius: 4px;
    }
</style>

@code {
    [Parameter] public PartSpecifications? OriginalSpecs { get; set; }
    [Parameter] public PartSpecifications? AlternativeSpecs { get; set; }

    private class SpecComparison
    {
        public object? Original { get; set; }
        public object? Alternative { get; set; }
    }

    private Dictionary<string, SpecComparison> GetKeySpecifications(
        Dictionary<string, object> originalSpecs,
        Dictionary<string, object> alternativeSpecs)
    {
        var keySpecs = new Dictionary<string, SpecComparison>();

        // Focus on the most important specifications for HVAC parts
        var importantKeys = new[]
        {
            "voltage", "current", "power", "wattage", "amperage", "capacity",
            "btu", "tonnage", "cfm", "rpm", "phase", "frequency",
            "width", "height", "depth", "diameter", "weight"
        };

        foreach (var key in importantKeys)
        {
            var originalKey = originalSpecs.Keys.FirstOrDefault(k =>
                k.ToLower().Contains(key.ToLower()));
            var alternativeKey = alternativeSpecs.Keys.FirstOrDefault(k =>
                k.ToLower().Contains(key.ToLower()));

            if (originalKey != null && alternativeKey != null)
            {
                var originalValue = originalSpecs[originalKey];
                var alternativeValue = alternativeSpecs[alternativeKey];

                // Only include if values are different
                if (!ValuesAreEqual(originalValue, alternativeValue))
                {
                    keySpecs[originalKey] = new SpecComparison
                        {
                            Original = originalValue,
                            Alternative = alternativeValue
                        };
                }
            }
        }

        return keySpecs;
    }

    private Dictionary<string, object?> GetImportantSpecs(Dictionary<string, object> specs)
    {
        var importantKeys = new[]
        {
            "voltage", "current", "power", "wattage", "amperage", "capacity",
            "btu", "tonnage", "cfm", "rpm", "phase", "frequency"
        };

        var important = new Dictionary<string, object?>();

        foreach (var key in importantKeys)
        {
            var matchingKey = specs.Keys.FirstOrDefault(k =>
                k.ToLower().Contains(key.ToLower()));

            if (matchingKey != null && specs[matchingKey] != null)
            {
                important[matchingKey] = specs[matchingKey];
            }
        }

        // If we don't have enough important specs, add a few more
        if (important.Count < 3)
        {
            foreach (var kvp in specs.Take(5))
            {
                if (!important.ContainsKey(kvp.Key) && kvp.Value != null)
                {
                    important[kvp.Key] = kvp.Value;
                }
            }
        }

        return important;
    }

    private bool ValuesAreEqual(object? value1, object? value2)
    {
        if (value1 == null && value2 == null) return true;
        if (value1 == null || value2 == null) return false;

        var str1 = value1.ToString()?.Trim().ToLower();
        var str2 = value2.ToString()?.Trim().ToLower();

        return str1 == str2;
    }

    private string GetComparisonClass(object? original, object? alternative)
    {
        if (original == null || alternative == null) return "different";

        var origStr = original.ToString()?.ToLower();
        var altStr = alternative.ToString()?.ToLower();

        // Try to parse as numbers for comparison
        if (double.TryParse(origStr, out var origNum) && double.TryParse(altStr, out var altNum))
        {
            if (altNum > origNum) return "better";
            if (altNum < origNum) return "worse";
            return "";
        }

        return "different";
    }

    private string FormatSpecName(string key)
    {
        // Convert camelCase and snake_case to readable format
        var formatted = key
            .Replace("_", " ")
            .Replace("-", " ");

        // Add spaces before capital letters in camelCase
        var result = "";
        for (int i = 0; i < formatted.Length; i++)
        {
            if (i > 0 && char.IsUpper(formatted[i]))
                result += " ";
            result += formatted[i];
        }

        // Capitalize first letter of each word
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(result.ToLower());
    }

    private string FormatValue(object? value)
    {
        if (value == null) return "N/A";

        var stringValue = value.ToString();
        if (string.IsNullOrWhiteSpace(stringValue)) return "N/A";

        return stringValue;
    }
}