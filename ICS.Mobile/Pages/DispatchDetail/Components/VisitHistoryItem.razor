        // try
        // {
        //     var json = System.Text.Json.JsonSerializer.Serialize(ExpandedVisit);
        //     await JSRuntime.InvokeVoidAsync("localStorage.setItem", "expandedVisitAppwideList", json);
        // }
        // catch { }

        // StateHasChanged();
        if (id > 0)
        {
            if (ToggleExpandedCallback.HasDelegate)
                await ToggleExpandedCallback.InvokeAsync(id);
        }
    }

    #endregion
