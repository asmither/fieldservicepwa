    private int GetCategoryOrder(string categoryName)
    {
        return categoryName switch
        {
            "ServiceFacts" => 1,
            "PartsManuals" => 2,
            "IOM" => 3,
            "ProductData" => 4,
            "WiringDiagrams" => 5,
            "Nomenclature" => 6,
            "ProductBrochures" => 7,
            "ControlsManuals" => 8,
            "SchematicDrawings" => 9,
            "Warranty" => 10,
            "Diagnostic" => 11,
            "BluonGuidelines" => 12,
            "Miscellaneous" => 13,
            _ => 99
        };
    }

    private string? GetDocumentTitle(string? url)
    {
        if (string.IsNullOrEmpty(url)) return null;

        try
        {
            var uri = new Uri(url);
            var filename = System.IO.Path.GetFileNameWithoutExtension(uri.LocalPath);
            return !string.IsNullOrEmpty(filename) ? filename : null;
        }
        catch
        {
            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Load saved Expanded Equipment Items state from localStorage
        try
        {
            var savedState = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "expandedEquipment");
            if (!string.IsNullOrEmpty(savedState))
                expandedEquipment = System.Text.Json.JsonSerializer.Deserialize<HashSet<string>>(savedState) ?? new();
            else
                expandedEquipment = new();

            // Load saved expanded groups state from localStorage
            var savedGroupsState = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "expandedEquipmentGroups");
            if (!string.IsNullOrEmpty(savedGroupsState))
                expandedGroups = System.Text.Json.JsonSerializer.Deserialize<HashSet<string>>(savedGroupsState) ?? new();
            else
                expandedGroups = new();

            // auto-reduce list size if over 48 items down to 15.  Randomly chosen, feel free to tweak.
            if (expandedEquipment is not null && expandedEquipment.Any() && expandedEquipment.Count > 48)
            {
                HashSet<string> NewExpandedVisit = new HashSet<string>(
                    expandedEquipment.Skip(expandedEquipment.Count - 15).Take(15)
                );

                expandedEquipment?.Clear(); expandedEquipment = null;
                expandedEquipment = NewExpandedVisit;

            }

            // If 2 or fewer items total, expand everything to be nice and save a chap a tap!
            if (EquipList is not null && (EquipList?.Count ?? 0) > 0 && (EquipList?.Count ?? 0) <= 2)
            {
                // Expand all equipment items
                foreach (var eq in EquipList.Where(x => !x.IsRetired))
                {
                    var equipmentId = GetEquipmentId(eq);
                    expandedEquipment.Add(equipmentId);
                }

                // Also expand all groups so the equipment is visible
                var groups = EquipList
                    .Where(x => !x.IsRetired && !string.IsNullOrWhiteSpace(x.EquipmentGroup))
                    .Select(x => x.EquipmentGroup)
                    .Distinct()
                    .ToList();

                foreach (var groupName in groups)
                {
                    if (!string.IsNullOrEmpty(groupName))
                        expandedGroups.Add(groupName);
                }
            }
        }
        catch { }
    }

    private RenderFragment RenderEquipmentCard(WorkflowEquipment eq, bool isRetired) => __builder =>
    {
        var isExpanded = IsEquipmentExpanded(eq);

        <div class="equipment-card @(!isExpanded ? "collapsed" : "") @(isRetired ? "retired-card" : "")">
            <div class="equipment-header" @onclick="() => ToggleEquipment(eq)">
                <div class="equipment-title">
                    <i class="bi bi-gear-wide-connected"></i>
                    <span>@(eq.UnitTag ?? "Equipment")</span>
                    @if (isRetired)
                    {
                        <span class="retired-badge">RETIRED</span>
                    }
                    @if (!isExpanded && (!string.IsNullOrEmpty(eq.Make) || !string.IsNullOrEmpty(eq.Serial)))
                    {
                        <span class="collapsed-info">
                            @if (!string.IsNullOrEmpty(eq.Make))
                            {
                                <span>@eq.Make.ToUpper() @eq.Model.Left(3)</span>
                            }
                            @if (!string.IsNullOrEmpty(eq.Make) && !string.IsNullOrEmpty(eq.Serial) && eq.Serial.Length >= 4)
                            {
                                <span class="separator">•</span>
                            }
                            @if (!string.IsNullOrEmpty(eq.Serial) && eq.Serial.Length >= 4)
                            {
                                <span>@eq.Serial.Right(3)</span>
                            }
                            else if (!string.IsNullOrEmpty(eq.Serial))
                            {
                                <span>@eq.Serial</span>
                            }
                        </span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(eq.EquipLocArea))
                {
                    <div class="equipment-location">
                        <i class="bi bi-geo-alt"></i>
                        <span>@eq.EquipLocArea</span>
                    </div>
                }
            </div>

            @if (isExpanded)
            {
                <div class="equipment-details">
                    @if (!string.IsNullOrEmpty(eq.Make))
                    {
                        <div class="detail-row">
                            <span class="detail-label">Make</span>
                            <span class="detail-value">@eq.Make.ToUpper()</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(eq.Model))
                    {
                        <div class="detail-row">
                            <span class="detail-label">Model</span>
                            <span class="detail-value">@eq.Model.ToUpper()</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(eq.Serial))
                    {
                        <div class="detail-row">
                            <span class="detail-label">Serial</span>
                            <span class="detail-value">@eq.Serial.ToUpper()</span>
                        </div>
                    }
                    @if (eq.MfgDate.HasValue)
                    {
                        <div class="detail-row">
                            <span class="detail-label">Mfg Date</span>
                            <span class="detail-value">@eq.MfgDate.Value.ToString("M/yyyy") @DateFormatOptions.TimeAgo(eq.MfgDate.Value)</span>
                        </div>
                    }

                    @if (eq.Attributes != null && eq.Attributes.Count > 0)
                    {
                        @foreach (var attrib in eq.Attributes)
                        {
                            @if (!string.IsNullOrEmpty(attrib.Value))
                            {
                                <div class="detail-row">
                                    <span class="detail-label">@attrib.Name</span>
                                    <span class="detail-value">@attrib.Value</span>
                                </div>
                            }
                        }
                    }

                    @if (eq.Consumables != null && eq.Consumables.Count > 0)
                    {
                        @foreach (var consumable in eq.Consumables)
                        {
                            @if (!string.IsNullOrEmpty(consumable.Value) && consumable.Quantity > 0)
                            {
                                <div class="detail-row qty-row">
                                    <span class="detail-label">
                                        Qty @(consumable.Quantity.HasValue
                                    ? (consumable.Quantity % 1 == 0
                                    ? consumable.Quantity.Value.ToString("0")
                                    : consumable.Quantity.Value.ToString("0.###"))
                                    : "")
                                    </span>
                                    <span class="detail-value qty-value">@consumable.Value.Replace("~", " #")</span>
                                </div>
                            }
                        }
                    }

                    @if (!string.IsNullOrEmpty(eq.Notes))
                    {
                        <div class="detail-row notes-row">
                            <span class="detail-label">Notes</span>
                            <span class="detail-value notes-value">@((MarkupString)PageBase.TextToHtml(eq.Notes))</span>
                        </div>
                    }
                </div>

                <div class="equipment-actions">
                    @if (BluonEnabled && !isRetired)
                    {
                        <button class="action-button primary" @onclick="() => ShowModelSearch(eq)" @onclick:stopPropagation="true" disabled="@isSearching">
                            @if (isSearching)
                            {
                                <div class="spinner-small"></div>
                                <span>Searching...</span>
                            }
                            else
                            {
                                <i class="bi bi-book"></i>
                                <span>Manuals & Parts</span>
                            }
                        </button>

                        <button class="action-button history" @onclick="() => ShowEquipmentUsages(eq)" @onclick:stopPropagation="true">
                            <i class="bi bi-clock-history"></i>
                            <span>Prior Visits</span>
                        </button>
                    }
                </div>
            }
        </div>
    };
}
