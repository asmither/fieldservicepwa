    {
        if (GoToWorkflowReviewClick.HasDelegate)
        {
            await GoToWorkflowReviewClick.InvokeAsync(wf);
        }
    }

    private async Task OpenDocument(string? url)
    {
        if (!string.IsNullOrEmpty(url))
        {
            try
            {
                // Open the document in a new tab/window
                await JSRuntime.InvokeAsync<object>("open", new object[] { url, "_blank" });
            }
            catch (Exception ex)
            {
                if (debugMode) Console.WriteLine($"Error opening document: {ex.Message}");
            }
        }
    }

