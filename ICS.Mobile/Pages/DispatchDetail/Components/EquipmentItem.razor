@code {

        [Inject] protected IJSRuntime JSRuntime { set; get; } = default!;
        [Inject] protected IWorkflowData DataService { set; get; } = default!;
        [Inject] protected SettingsService SettingsService { set; get; } = default!;
        [Inject] protected HTTPService HTTPService { set; get; } = default!;
        [Inject] protected ScratchPadService ScratchPadSvc { get; set; } = default!;

        [Parameter] public List<WorkflowEquipment>? EquipList { set; get; } = null;

        [Parameter] public EventCallback<int> GoToWorkflowReviewClick { get; set; }


        [Parameter] public bool BluonEnabled { set; get; } = false;

    public bool debugMode = false;

    private enum ViewState
    {
        Equipment,      // default equipment list view
        ModelSearch,    // simple model search view
        Manuals,        // Manuals - renderer inside this control
        ChooseView,    // Choose between Manuals and Parts
        Parts,         // Parts list view - calls BluonExplorer
        PartDetails,    // Individual part details - calls BluonExplorer
        EquipmentUsages  // list of workflows using the equipment
    }

    private ViewState currentView = ViewState.Equipment;
    private bool isSearching = false;
    private bool isLoadingManuals = false;
    private bool isLoadingAlternatives = false;
    private bool isLoadingParts = false;

    private string searchModel = "";
    private string editedSearchModel = "";
    private WorkflowEquipment? currentEquipment = null;

    private List<EquipmentFindUsagesResult>? equipmentUsages = null;

    private List<ModelSearch.ModelData>? modelSearchResults;
    private ModelSearch.ModelData? selectedModel;
    private ModelManuals.Root? modelManuals;

    // Parts-related state - using the correct types
    private List<BluonBrands.BrandPartsAndOem.Datum>? partsList;
    private BluonBrands.BrandPartsAndOem.Datum? selectedPart;
    private List<BluonParts.PartAlternatives.Datum>? alternativeParts;
    private BluonParts.PartInfo.Root? selectedPartInfo;  // For specifications

    private HashSet<string> expandedCategories = new HashSet<string> { "ServiceFacts", "PartsManuals" };
    private HashSet<string> expandedEquipment = new HashSet<string>();
    private HashSet<string> expandedGroups = new HashSet<string>();

    // Bluon service instances
    private BluonModels? bluonModels = null;
    private BluonBrands? bluonBrands = null;
    private BluonParts? bluonParts = null;  // BluonParts service

    protected override void OnParametersSet()
    {
        if (BluonEnabled)
            InitializeBluonServices();

    }


    public async Task FindEquipmentUsages(WorkflowEquipment eq)
    {

        if (eq == null || DataService == null)
            return;

        // Go get all dispatches
        var response = await HTTPService!.GetHttpQueriesClient(DataService.AppState.AuthorizedUser!).PostAsync<EquipmentFindUsagesOutput>(new
            EquipmentFindUsagesInput()
            {
                EquipmentId = eq.Id
            });
        if (response.IsSuccess)
        {
            var output = response.Data!;
            if (output.ReturnValue == EquipmentFindUsagesOutput.Returns.Ok)
            {
                equipmentUsages = output.ResultData;
            }
            else
            {
                equipmentUsages = null;
            }
        }
    }

    private string GetEquipmentId(WorkflowEquipment eq)
    {
        // Create a unique identifier for each equipment item
        return $"{eq.Id}"; // $"{eq.UnitTag}_{eq.Make}_{eq.Model}_{eq.Serial}";
    }

    private async Task ToggleEquipment(WorkflowEquipment eq)
    {
        var equipmentId = GetEquipmentId(eq);
        if (expandedEquipment.Contains(equipmentId))
            expandedEquipment.Remove(equipmentId);
        else
            expandedEquipment.Add(equipmentId);

        // Save to localStorage
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(expandedEquipment);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "expandedEquipment", json);
        }
        catch { }

        StateHasChanged();
    }

    private bool IsEquipmentExpanded(WorkflowEquipment eq)
    {
        return expandedEquipment.Contains(GetEquipmentId(eq));
    }

    private async Task ToggleGroup(string groupName)
    {
        if (expandedGroups.Contains(groupName))
            expandedGroups.Remove(groupName);
        else
            expandedGroups.Add(groupName);

        // Save to localStorage
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(expandedGroups);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "expandedEquipmentGroups", json);
        }
        catch { }

        StateHasChanged();
    }

    private bool IsGroupExpanded(string groupName)
    {
        return expandedGroups.Contains(groupName);
    }

    private void InitializeBluonServices()
    {
        if (!string.IsNullOrWhiteSpace(SettingsService.BluonApiKey))
        {
            // Get API settings from settings
            string? apiKey = SettingsService.BluonApiKey ?? string.Empty;
            string? apiRoot = SettingsService.BluonApiRoot ?? string.Empty;
            string? userId = DataService?.AppState?.EmployeeId?.ToString() ?? "0";

            // Initialize Bluon Decoder Class
            if (!string.IsNullOrWhiteSpace(apiKey) && !string.IsNullOrWhiteSpace(apiRoot))
            {
                bluonModels = new BluonModels(apiKey, apiRoot, userId, DataService as IBluonCache);
                bluonBrands = new BluonBrands(apiKey, apiRoot, userId, DataService as IBluonCache);
                bluonParts = new BluonParts(apiKey, apiRoot, userId, DataService as IBluonCache);
                BluonEnabled = true;
            }
        }
        else
            BluonEnabled = false;
    }

    private async Task ShowEquipmentUsages(WorkflowEquipment eq)
    {
        if (eq == null)
            return;
        try
        {
            await FindEquipmentUsages(eq);
            currentEquipment = eq;
            currentView = ViewState.EquipmentUsages;
        }
        catch (Exception ex)
        {
            if (debugMode) Console.WriteLine($"Error loading past history: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }

    }
    private async Task ShowModelSearch(WorkflowEquipment eq)
    {
        if (eq == null || string.IsNullOrEmpty(eq.Model) || bluonModels == null)
            return;

        currentEquipment = eq;
        searchModel = eq.Model;
        editedSearchModel = searchModel;
        isSearching = true;
        currentView = ViewState.ModelSearch;
        StateHasChanged();

        try
        {
            // Search for models using the Bluon API
            var results = await bluonModels.ModelNameSearch(searchModel);
            modelSearchResults = results?.Data;
        }
        catch (Exception ex)
        {
            // Handle error
            if (debugMode) Console.WriteLine($"Error searching models: {ex.Message}");
            modelSearchResults = new List<ModelSearch.ModelData>();
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private async Task RefineSearch()
    {
        if (string.IsNullOrWhiteSpace(editedSearchModel) || bluonModels == null)
            return;

        searchModel = editedSearchModel;
        isSearching = true;
        StateHasChanged();

        try
        {
            var results = await bluonModels.ModelNameSearch(searchModel);
            modelSearchResults = results?.Data;
        }
        catch (Exception ex)
        {
            if (debugMode) Console.WriteLine($"Error refining search: {ex.Message}");
            modelSearchResults = new List<ModelSearch.ModelData>();
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private async Task SelectModel(ModelSearch.ModelData model)
    {
        if (model == null || bluonModels == null)
            return;

        selectedModel = model;
        currentView = ViewState.ChooseView;  // Go to choice view instead of directly to manuals
        StateHasChanged();
    }

    private void BackToEquipment()
    {
        currentView = ViewState.Equipment;
        modelSearchResults = null;
        currentEquipment = null;
        StateHasChanged();
    }

    // Helper method to count total manuals across all categories
    private int CountTotalManuals(ModelManuals.ManualSets manuals)
    {
        int count = 0;
        if (manuals.ServiceFacts?.Any() == true) count += manuals.ServiceFacts.Count;
        if (manuals.PartsManuals?.Any() == true) count += manuals.PartsManuals.Count;
        if (manuals.Iom?.Any() == true) count += manuals.Iom.Count;
        if (manuals.ProductData?.Any() == true) count += manuals.ProductData.Count;
        if (manuals.WiringDiagram?.Any() == true) count += manuals.WiringDiagram.Count;
        if (manuals.Nomenclature?.Any() == true) count += manuals.Nomenclature.Count;
        if (manuals.ProductBrochures?.Any() == true) count += manuals.ProductBrochures.Count;
        if (manuals.ControlsManuals?.Any() == true) count += manuals.ControlsManuals.Count;
        if (manuals.SchematicDrawings?.Any() == true) count += manuals.SchematicDrawings.Count;
        if (manuals.Warranty?.Any() == true) count += manuals.Warranty.Count;
        if (manuals.Diagnostic?.Any() == true) count += manuals.Diagnostic.Count;
        if (manuals.BluonGuidelines?.Any() == true) count += manuals.BluonGuidelines.Count;
        if (manuals.Misc?.Any() == true) count += manuals.Misc.Count;
        return count;
    }

    private void BackToModelSearch()
    {
        currentView = ViewState.ModelSearch;
        modelManuals = null;
        partsList = null;
        StateHasChanged();
    }

    private void BackToChooseView()
    {
        currentView = ViewState.ChooseView;
        StateHasChanged();
    }

    private void BackToParts()
    {
        currentView = ViewState.Parts;
        selectedPart = null;
        alternativeParts = null;
        StateHasChanged();
    }

    private async Task ShowManuals()
    {
        if (selectedModel == null || bluonModels == null)
            return;

        isLoadingManuals = true;
        currentView = ViewState.Manuals;
        StateHasChanged();

        try
        {
            // Get manuals for the selected model
            modelManuals = await bluonModels.GetManualsForModel(selectedModel.Id);

            // Debug logging to check what manuals we received
            if (modelManuals?.Data?.Manuals != null)
            {
                var manuals = modelManuals.Data.Manuals;


                if (debugMode) Console.WriteLine($"Total manual categories found: {CountTotalManuals(manuals)}");

                if (debugMode)
                {
                    // Log each category that has manuals
                    if (manuals.ServiceFacts?.Any() == true)
                        Console.WriteLine($"ServiceFacts: {manuals.ServiceFacts.Count}");
                    if (manuals.PartsManuals?.Any() == true)
                        Console.WriteLine($"PartsManuals: {manuals.PartsManuals.Count}");
                    if (manuals.Iom?.Any() == true)
                        Console.WriteLine($"IOM: {manuals.Iom.Count}");
                    if (manuals.ProductData?.Any() == true)
                        Console.WriteLine($"ProductData: {manuals.ProductData.Count}");
                    if (manuals.WiringDiagram?.Any() == true)
                        Console.WriteLine($"WiringDiagram: {manuals.WiringDiagram.Count}");
                    if (manuals.Nomenclature?.Any() == true)
                        Console.WriteLine($"Nomenclature: {manuals.Nomenclature.Count}");
                    if (manuals.ProductBrochures?.Any() == true)
                        Console.WriteLine($"ProductBrochures: {manuals.ProductBrochures.Count}");
                    if (manuals.ControlsManuals?.Any() == true)
                        Console.WriteLine($"ControlsManuals: {manuals.ControlsManuals.Count}");
                    if (manuals.SchematicDrawings?.Any() == true)
                        Console.WriteLine($"SchematicDrawings: {manuals.SchematicDrawings.Count}");
                    if (manuals.Warranty?.Any() == true)
                        Console.WriteLine($"Warranty: {manuals.Warranty.Count}");
                    if (manuals.Diagnostic?.Any() == true)
                        Console.WriteLine($"Diagnostic: {manuals.Diagnostic.Count}");
                    if (manuals.BluonGuidelines?.Any() == true)
                        Console.WriteLine($"BluonGuidelines: {manuals.BluonGuidelines.Count}");
                    if (manuals.Misc?.Any() == true)
                        Console.WriteLine($"Misc: {manuals.Misc.Count}");
                }
            }
        }
        catch (Exception ex)
        {
            if (debugMode) Console.WriteLine($"Error loading manuals: {ex.Message}");
            modelManuals = null;
        }
        finally
        {
            isLoadingManuals = false;
            StateHasChanged();
        }
    }

    private async Task ShowParts()
    {
        if (selectedModel == null || bluonBrands == null)
            return;

        isLoadingParts = true;
        currentView = ViewState.Parts;
        StateHasChanged();

        try
        {
            // Get parts for the selected model using the brand API
            var partsResult = await bluonBrands.GetBrandOemParts(selectedModel.BrandName ?? "", selectedModel.Id);
            partsList = partsResult?.Data;

            if (debugMode) Console.WriteLine($"Loaded {partsList?.Count ?? 0} parts for model {selectedModel.Model}");
        }
        catch (Exception ex)
        {
            if (debugMode) Console.WriteLine($"Error loading parts: {ex.Message}");
            partsList = null;
        }
        finally
        {
            isLoadingParts = false;
            StateHasChanged();
        }
    }

    private async void OnPartSelected(BrandPartsAndOem.Datum part)
    {
        selectedPart = part;
        currentView = ViewState.PartDetails;
        StateHasChanged();

        // Load alternatives and part info asynchronously
        await LoadPartAlternatives();
        await LoadPartInfo();
    }

    private async Task OnAddPartToProject(BrandPartsAndOem.Datum part)
    {

        // call clipboard and append text

        await ScratchPadSvc.AddItemAsync(null, $"{part.Number} {part.Subtype} {part.Description} \r\n{part.Subcategory}");
        //\r\n{ParseSpecsForText(part)}", ScratchPadItemType.Note);
        ScratchPadSvc.Show();
        // For now, just log it
        if (debugMode) Console.WriteLine($"Part added to project: {part.Number} - {part.Description}");
        


    }

    private void OnAlternativeSelected(PartAlternatives.Datum alternative)
    {
        // For now, we can't easily convert between types
        // This would need proper mapping or API call to get the full part details
        if (debugMode) Console.WriteLine($"Alternative selected: {alternative?.Details?.Description} - {alternative?.Details?.Number}");
        StateHasChanged();
    }

    private async Task LoadPartAlternatives()
    {
        if (selectedPart == null || bluonParts == null) return;
        isLoadingAlternatives = true;
        StateHasChanged();
        try
        {
            var alternativesResponse = await bluonParts.GetAllPartAlternatives(selectedPart.Id, 50);
            alternativeParts = alternativesResponse;
            if (debugMode) Console.WriteLine($"Loaded {alternativeParts?.Count ?? 0} alternatives for part {selectedPart.Number}");
        }
        catch (Exception ex)
        {
            if (debugMode) Console.WriteLine($"Error loading alternatives: {ex.Message}");
            alternativeParts = null;
        }
        finally
        {
            isLoadingAlternatives = false;
            StateHasChanged();
        }
    }

    private async Task LoadPartInfo()
    {
        if (selectedPart == null || bluonParts == null) return;
        try
        {
            selectedPartInfo = await bluonParts.GetPartInfo(selectedPart.Id);
            if (debugMode) Console.WriteLine($"Loaded part info for {selectedPart.Number}");
            if (selectedPartInfo?.Data?.Specifications != null)
            {
                if (debugMode) Console.WriteLine($"Part has {selectedPartInfo.Data.Specifications.GetSpecificationCount} specifications");
            }
        }
        catch (Exception ex)
        {
            if (debugMode) Console.WriteLine($"Error loading part info: {ex.Message}");
            selectedPartInfo = null;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private string GetConfidenceStyle(double confidence)
    {
        var percentage = confidence * 100;
        if (percentage >= 90)
            return "background: #d4edda; color: #155724;";
        else if (percentage >= 70)
            return "background: #fff3cd; color: #856404;";
        else
            return "background: #f8d7da; color: #721c24;";
    }

    private void ToggleCategory(string categoryName)
    {
        if (expandedCategories.Contains(categoryName))
            expandedCategories.Remove(categoryName);
        else
            expandedCategories.Add(categoryName);
        StateHasChanged();
    }

