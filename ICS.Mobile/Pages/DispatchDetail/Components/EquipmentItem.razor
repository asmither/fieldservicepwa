@using ICS.Mobile.Services
@using ICS.Portal.Data.Queries.Models
@using ICS.Portal.Data.Custom
@using static ICS.Portal.Data.Custom.BluonModels
@using static ICS.Portal.Data.Custom.BluonBrands
@using static ICS.Portal.Data.Custom.BluonParts
@using ICS.Mobile.Pages.BluonBrowse.Components

<div class="equipment-item-container">
    @if (currentView == ViewState.Equipment && EquipList != null)
    {
        @* 1. UNGROUPED EQUIPMENT - Show first without group header *@

        var ungroupedEquipment = EquipList.Where(x => !x.IsRetired && string.IsNullOrWhiteSpace(x.EquipmentGroup)).ToList();

        @if (ungroupedEquipment.Any())
        {
            @foreach (var eq in ungroupedEquipment)
            {
                @RenderEquipmentCard(eq, false)
            }
        }

        @* 2. GROUPED EQUIPMENT - Alphabetical by group name *@

        var groupedEquipment = EquipList
        .Where(x => !x.IsRetired && !string.IsNullOrWhiteSpace(x.EquipmentGroup))
        .GroupBy(x => x.EquipmentGroup)
        .OrderBy(g => g.Key)
        .ToList();

        @foreach (var group in groupedEquipment)
        {
            var groupName = group.Key ?? "Unknown Group";
            var isGroupExpanded = IsGroupExpanded(groupName);
            var equipmentCount = group.Count();

            <div class="equipment-group">
                <div class="group-header @(!isGroupExpanded ? "collapsed" : "")" @onclick="() => ToggleGroup(groupName)">
                    <div class="group-title">
                        <i class="bi @(isGroupExpanded ? "bi-folder2-open" : "bi-folder2")"></i>
                        <span>@groupName</span>
                        <span class="group-count">@equipmentCount</span>
                    </div>
                    <i class="bi @(isGroupExpanded ? "bi-chevron-up" : "bi-chevron-down") group-chevron"></i>
                </div>

                @if (isGroupExpanded)
                {
                    <div class="group-content">
                        @foreach (var eq in group)
                        {
                            @RenderEquipmentCard(eq, false)
                        }
                    </div>
                }
            </div>
        }

        @* 3. RETIRED EQUIPMENT - Show last *@

        var retiredEquipment = EquipList.Where(x => x.IsRetired).ToList();

        @if (retiredEquipment.Any())
        {
            var isRetiredExpanded = IsGroupExpanded("__RETIRED__");
            var retiredCount = retiredEquipment.Count();

            <div class="equipment-group retired-group">
                <div class="group-header retired-header @(!isRetiredExpanded ? "collapsed" : "")" @onclick='() => ToggleGroup("__RETIRED__")'>
                    <div class="group-title">
                        <i class="bi bi-archive"></i>
                        <span>Retired Equipment</span>
                        <span class="group-count retired-count">@retiredCount</span>
                    </div>
                    <i class="bi @(isRetiredExpanded ? "bi-chevron-up" : "bi-chevron-down") group-chevron"></i>
                </div>

                @if (isRetiredExpanded)
                {
                    <div class="group-content">
                        @foreach (var eq in retiredEquipment)
                        {
                            @RenderEquipmentCard(eq, true)
                        }
                    </div>
                }
            </div>
        }
    }
    else if (currentView == ViewState.EquipmentUsages)
    {
        <!-- EquipmentUsages View -->
        <div class="manuals-panel">
            <div class="manuals-header">
                <button class="back-button" @onclick="BackToEquipment">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <div class="manuals-title">
                    <h3>@selectedModel?.Model</h3>
                    <p class="manuals-subtitle">@currentEquipment?.UnitTag @currentEquipment?.Make</p>
                </div>
            </div>
            @if (equipmentUsages is not null && equipmentUsages.Any())
            {
                <div class="manuals-list">
                    <div class="category-documents">
                        @foreach (var doc in equipmentUsages)
                        {
                            <div class="document-item">
                                <div class="document-icon">
                                    <i class="bi bi-checklist"></i>
                                </div>
                                <div class="document-info" @onclick="() => OpenWorkflow(doc.WorkflowResultId)">
                                    <p class="document-title">
                                        @($"{doc.LastActivity.ToString("MMM dd yyyy")} - {doc.ClientWorkOrder} | {doc.PurchaseOrderNumber} ")
                                        @if (doc.Priority.ToUpper() != "NORMAL")
                                        {
                                            @doc.Priority
                                        }
                                    </p>
                                    <p class="document-description">
                                        @doc.Workflow<br />
                                        @doc.FirstName @doc.LastName | @doc.DispZone | @doc.Customer.Left(10)
                                    </p>
                                </div>
                                <div class="document-action">
                                    <i class="bi bi-journal-text"></i>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-file-text"></i>
                    <h4>No Prior Visits Available</h4>
                    <p>No checklists found for this equipment</p>
                </div>

            }

        </div>
    }
    else if (currentView == ViewState.ModelSearch)
    {
        <!-- Model Search Results View -->
        <div class="search-panel">
            <div class="search-header">
                <button class="back-button" @onclick="BackToEquipment">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <div class="search-title">
                    <h3>Select Equipment Model</h3>
                    <p class="search-subtitle">Search: @searchModel</p>
                </div>
            </div>

            <div class="search-edit-section">
                <div class="edit-input-group">
                    <input type="text" @bind="editedSearchModel" @bind:event="oninput"
                    class="edit-input" placeholder="Refine model search..." />
                    <button class="edit-button" @onclick="RefineSearch" disabled="@(isSearching || string.IsNullOrWhiteSpace(editedSearchModel))">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
                @if (editedSearchModel != searchModel && !string.IsNullOrWhiteSpace(editedSearchModel))
                {
                    <p class="edit-hint">Press search to refine results</p>
                }
            </div>

            @if (isSearching)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Searching for models...</p>
                </div>
            }
            else if (modelSearchResults != null && modelSearchResults.Any())
            {
                <div class="model-list">
                    @foreach (var model in modelSearchResults)
                    {
                        <div class="model-card" @onclick="() => SelectModel(model)">
                            <div class="model-header">
                                @if (!string.IsNullOrEmpty(model.BrandImage))
                                {
                                    <img src="@model.BrandImage" alt="@model.BrandName" class="brand-logo" />
                                }
                                else
                                {
                                    <div class="brand-placeholder">
                                        <i class="bi bi-building"></i>
                                    </div>
                                }
                                <div class="model-info">
                                    <h4 class="model-name">@model.Model</h4>
                                    <p class="brand-name">@(model.BrandName ?? "Unknown Brand")</p>
                                </div>
                            </div>

                            <div class="model-stats">
                                <div class="stat">
                                    <i class="bi bi-book-fill"></i>
                                    <span>@(model.ManualsCount ?? 0) Manuals</span>
                                </div>
                                <div class="stat">
                                    <i class="bi bi-tools"></i>
                                    <span>@(model.FunctionalPartsCount ?? 0) Parts</span>
                                </div>
                                @if (model.ConfidenceScore.HasValue)
                                {
                                    <div class="confidence-badge" style="@GetConfidenceStyle(model.ConfidenceScore.Value)">
                                        @($"{model.ConfidenceScore.Value:P0} Match")
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(model.SystemType))
                            {
                                <div class="model-type">
                                    <i class="bi bi-tag"></i>
                                    <span>@model.SystemType</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (modelSearchResults != null)
            {
                <div class="empty-state">
                    <i class="bi bi-search-x"></i>
                    <h4>No Models Found</h4>
                    <p>Try editing the model number above for better results</p>
                </div>
            }
        </div>
    }
    else if (currentView == ViewState.Manuals)
    {
        <!-- Manuals View -->
        <div class="manuals-panel">
            <div class="manuals-header">
                <button class="back-button" @onclick="BackToChooseView">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <div class="manuals-title">
                    <h3>@selectedModel?.Model</h3>
                    <p class="manuals-subtitle">@selectedModel?.BrandName</p>
                </div>
            </div>

            @if (isLoadingManuals)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Loading manuals...</p>
                </div>
            }
            else if (modelManuals?.Data?.Manuals != null)
            {
                var manuals = modelManuals.Data.Manuals;
                var docGroups = GetDocumentationGroups(manuals);

                @if (docGroups.Any())
                {
                    <div class="manuals-list">
                        @foreach (var group in docGroups.Where(g => g.Documents.Any()))
                        {
                            <div class="manual-category">
                                <div class="category-header" @onclick="() => ToggleCategory(group.CategoryName)">
                                    <div class="category-info">
                                        <i class="bi @group.Icon"></i>
                                        <span class="category-name">@group.DisplayName</span>
                                        <span class="badge">@group.Documents.Count</span>
                                    </div>
                                    <i class="bi @(expandedCategories.Contains(group.CategoryName) ? "bi-chevron-up" : "bi-chevron-down") chevron"></i>
                                </div>

                                @if (expandedCategories.Contains(group.CategoryName))
                                {
                                    <div class="category-documents">
                                        @foreach (var doc in group.Documents)
                                        {
                                            <div class="document-item" @onclick="() => OpenDocument(doc.Url)">
                                                <div class="document-icon">
                                                    <i class="bi bi-file-pdf-fill"></i>
                                                </div>
                                                <div class="document-info">
                                                    <p class="document-title">@doc.Title</p>
                                                    @if (!string.IsNullOrEmpty(doc.Description))
                                                    {
                                                        <p class="document-description">@doc.Description</p>
                                                    }
                                                </div>
                                                <div class="document-action">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-file-text"></i>
                        <h4>No Documentation Available</h4>
                        <p>No manuals found for this model</p>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-exclamation-triangle"></i>
                    <h4>Unable to Load Manuals</h4>
                    <p>Please try again later</p>
                </div>
            }
        </div>
    }
    else if (currentView == ViewState.ChooseView)
    {
        <!-- Choice between Manuals and Parts -->
        <div class="choice-panel">
            <div class="choice-header">
                <button class="back-button" @onclick="BackToModelSearch">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <div class="choice-title">
                    <h3>@selectedModel?.Model</h3>
                    <p class="choice-subtitle">@selectedModel?.BrandName</p>
                </div>
            </div>

            <div class="choice-content">
                <div class="choice-cards">
                    <div class="choice-card" @onclick="ShowManuals">
                        <div class="choice-icon">
                            <i class="bi bi-book-fill"></i>
                        </div>
                        <div class="choice-info">
                            <h4>Manuals & Documentation</h4>
                            <p class="choice-count">@(selectedModel?.ManualsCount ?? 0) Available</p>
                        </div>
                        <div class="choice-arrow">
                            <i class="bi bi-chevron-right"></i>
                        </div>
                    </div>

                    <div class="choice-card" @onclick="ShowParts">
                        <div class="choice-icon">
                            <i class="bi bi-tools"></i>
                        </div>
                        <div class="choice-info">
                            <h4>Parts & Replacements</h4>
                            <p class="choice-count">@(selectedModel?.FunctionalPartsCount ?? 0) Available</p>
                        </div>
                        <div class="choice-arrow">
                            <i class="bi bi-chevron-right"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (currentView == ViewState.Parts)
    {
        <!-- Parts List View -->
        <div class="parts-panel">
            <div class="parts-header">
                <button class="back-button" @onclick="BackToChooseView">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <div class="parts-title">
                    <h3>Parts List</h3>
                    <p class="parts-subtitle">@selectedModel?.Model - @selectedModel?.BrandName</p>
                </div>
            </div>

            @if (isLoadingParts)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Loading parts...</p>
                </div>
            }
            else if (partsList != null && partsList.Any())
            {
                <div class="parts-list-container">
                    <MobilePartSearchResults Parts="@partsList"
                    SearchTerm="@(selectedModel?.Model ?? "")"
                    IsLoading="false"
                    OnPartSelected="@OnPartSelected" />
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-tools"></i>
                    <h4>No Parts Found</h4>
                    <p>No parts available for this model</p>
                </div>
            }
        </div>
    }
    else if (currentView == ViewState.PartDetails)
    {
        <!-- Part Details View -->
        <div class="part-details-panel">
            <div class="part-details-header">
                <button class="back-button" @onclick="BackToParts">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <div class="part-details-title">
                    <h3>Part Details</h3>
                    <p class="part-details-subtitle">@selectedPart?.Number</p>
                </div>
            </div>

            @if (selectedPart != null)
            {
                <div class="part-details-container">
                    <MobilePartDetails Part="@selectedPart"
                    PartInfo="@selectedPartInfo"
                    Alternatives="@alternativeParts"
                    HideSpecs=true
                    OnAddToProject="@OnAddPartToProject"
                    IsLoadingAlternatives="@isLoadingAlternatives" />
                </div>
                @if (selectedPartInfo?.Data.Specifications != null && selectedPartInfo?.Data.Specifications.ToDictionary().Count > 0)
                {
                    <div class="specifications-section" style="margin-top: 1rem;">
                        <h4 style="color: white; margin-bottom: 0.5rem;">Specifications</h4>
                        <MobileSpecificationsViewer Specifications="@selectedPartInfo.Data.Specifications" />
                    </div>
                }
            }
        </div>
    }
</div>

<link href="/css/bluon-dark.css" rel="stylesheet" />
<style>
    .equipment-item-container {
    width: 100%;
    min-height: 100px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: white;
    }

    /* Equipment Card Styles */
    .equipment-card {
    background: #1a1a1a;
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 2px 8px rgba(255, 255, 255, 0.1);
    margin-bottom: 1rem;
    border: 1px solid #333;
    transition: all 0.2s ease;
    }

    .equipment-card.collapsed {
    padding: 0;
    }

    .equipment-card.collapsed .equipment-header {
    border-bottom: none;
    padding: 1rem;
    margin-bottom: 0;
    }

    .equipment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #444;
    cursor: pointer;
    user-select: none;
    transition: all 0.2s ease;
    }

    .equipment-header:hover {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px 12px 0 0;
    }

    .equipment-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: white;
    }

    .equipment-title i {
    color: #4dabf7;
    font-size: 1.25rem;
    }

    .collapsed-info {
    margin-left: 1rem;
    font-size: 0.85rem;
    color: #A8AE96;
    font-weight: 400;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    }

    .collapsed-info .separator {
    color: #555;
    }

    /* Equipment Group Accordion Styles */
    .equipment-group {
    background: #252525;
    border-radius: 12px;
    margin-bottom: 1rem;
    border: 1px solid #444;
    overflow: hidden;
    }

    .group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem 1rem;
    cursor: pointer;
    user-select: none;
    transition: all 0.2s ease;
    background: linear-gradient(135deg, #2a3a4a 0%, #1e2a36 100%);
    }

    .group-header:hover {
    background: linear-gradient(135deg, #3aaa5a 0%, #2e5a46 100%);
    }

    .group-header.collapsed {
    border-radius: 12px;
    }

    .group-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    color: white;
    }

    .group-title i {
    font-size: 1.125rem;
    }

    .group-count {
    background: #4dabf7;
    color: #1a1a1a;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.125rem 0.5rem;
    border-radius: 10px;
    margin-left: 0.25rem;
    }

    .group-chevron {
    color: #adb5bd;
    font-size: 1rem;
    transition: transform 0.2s ease;
    }

    .group-content {
    padding: 0.5rem 0.75rem 0.75rem 0.75rem;
    background: #1e1e1e;
    }

    .group-content .equipment-card {
    margin-bottom: 0.75rem;
    }

    .group-content .equipment-card:last-child {
    margin-bottom: 0;
    }

    /* Retired Group Styles */
    .retired-group {
    border-color: #6c4a4a;
    }

    .retired-header {
    background: linear-gradient(135deg, #4a3232 0%, #362626 100%);
    }

    .retired-header:hover {
    background: linear-gradient(135deg, #5a4242 0%, #463636 100%);
    }

    .retired-header .group-title {
    color: #e07070;
    }

    .retired-header .group-title i {
    color: #e07070;
    }

    .retired-count {
    background: #e07070;
    }

    /* Retired Equipment Card */
    .equipment-card.retired-card {
    opacity: 0.8;
    border-color: #6c4a4a;
    }

    .retired-badge {
    background: #e07070;
    color: white;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    margin-left: 0.5rem;
    vertical-align: middle;
    }

    .equipment-location {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: #adb5bd;
    font-size: 0.875rem;
    }

    .equipment-details {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 1rem;
    }

    .detail-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1rem;
    padding: 0.375rem 0;
    align-items: center;
    }

    .detail-label {
    font-size: 0.875rem;
    color: #adb5bd;
    font-weight: 500;
    }

    .detail-value {
    font-size: 1.1rem;
    color: white;
    font-weight: 600;
    word-break: break-word;
    -webkit-user-select: all;
    -moz-user-select: all;
    -ms-user-select: element;
    user-select: all;
    }

    .qty-row {
    background: #2a2a2a;
    padding: 0.5rem;
    border-radius: 6px;
    margin-top: 0.25rem;
    border: 1px solid #444;
    -webkit-user-select: all;
    -moz-user-select: all;
    -ms-user-select: element;
    user-select: all;
    }

    .qty-value {
    font-size: 0.875rem;
    color: #f8f9fa;
    -webkit-user-select: all;
    -moz-user-select: all;
    -ms-user-select: element;
    user-select: all;
    }

    .notes-row {
    grid-template-columns: 100px 1fr;
    background: #3a3a00;
    padding: 0.5rem;
    border-radius: 6px;
    margin-top: 0.5rem;
    border: 1px solid #666600;
    }

    .notes-value {
    white-space: pre-wrap;
    font-size: 0.875rem;
    color: #ffff99;
    -webkit-user-select: all;
    -moz-user-select: all;
    -ms-user-select: element;
    user-select: all;
    }

    .equipment-actions {
    padding-top: 0.75rem;
    display: flex;
    justify-content: center; /* center them */
    gap: 1rem; /* spacing between buttons */
    flex-wrap: wrap; /* allows 3rd button later without breaking */
    width: 100%;
    }



    .action-button {
    flex: 1; /* allow equal widths */
    min-width: 160px;
    max-width: 250px;
    width: 40%;
    padding: 0.875rem;
    border: none;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
    }

    .action-button.primary {
    background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
    color: white;
    }

    .action-button.primary:hover:not(:disabled) {
    background: linear-gradient(135deg, #0056b3 0%, #004094 100%);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 123, 255, 0.25);
    }

    .action-button.history {
    background: linear-gradient(135deg, #ffff11 0%, #aaaa11 100%);
    color: black;
    }

    .action-button.history:hover:not(:disabled) {
    background: linear-gradient(135deg, #999900 0%, #444400 100%);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 255, 0, 0.25);
    }

    .action-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    }

    /* Search Panel Styles */
    .search-panel, .manuals-panel {
    background: #1a1a1ab0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(255, 255, 255, 0.1);
    border: 1px solid #aaaaaaF0;
    }

    .search-header, .manuals-header {
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
    color: white;
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    }

    .back-button {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: larger;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    }

    .back-button:hover {
    background: rgba(255, 255, 255, 0.3);
    font-weight: 800;
    }

    .search-title, .manuals-title {
    flex: 1;
    }

    .search-title h3, .manuals-title h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    }

    .search-subtitle, .manuals-subtitle {
    margin: 0.25rem 0 0;
