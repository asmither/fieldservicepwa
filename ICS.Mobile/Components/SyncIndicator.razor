@using ICS.Portal.Data.Custom
@implements IDisposable

@if (SyncCount != 0)
{
    <div class="SyncIndicator" role="status" style="@(SuppressClickableCloud == true ? "pointer-events: none;" : string.Empty)">
        <button class="@(InternetConnected ? "Internet" : "NoInternet")"
                aria-label="@SyncAriaLabel"
                @onclick="GoToSyncPage">
            <span aria-hidden="true">@SyncCount</span>
        </button>
    </div>
}
<style>

    :root {
        --cloud: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="rgba(255, 255,255,.5)" viewBox="0 0 16 16"><path d="M4.406 3.342A5.53 5.53 0 0 1 8 2c2.69 0 4.923 2 5.166 4.579C14.758 6.804 16 8.137 16 9.773 16 11.569 14.502 13 12.687 13H3.781C1.708 13 0 11.366 0 9.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383m.653.757c-.757.653-1.153 1.44-1.153 2.056v.448l-.445.049C2.064 6.805 1 7.952 1 9.318 1 10.785 2.23 12 3.781 12h8.906C13.98 12 15 10.988 15 9.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 4.825 10.328 3 8 3a4.53 4.53 0 0 0-2.941 1.1z"/></svg>');
        --cloudLightning: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="rgba(255, 255,255,.5)" viewBox="0 0 16 16"><path d="M13.405 4.027a5.001 5.001 0 0 0-9.499-1.004A3.5 3.5 0 1 0 3.5 10H13a3 3 0 0 0 .405-5.973M8.5 1a4 4 0 0 1 3.976 3.555.5.5 0 0 0 .5.445H13a2 2 0 0 1 0 4H3.5a2.5 2.5 0 1 1 .605-4.926.5.5 0 0 0 .596-.329A4 4 0 0 1 8.5 1M7.053 11.276A.5.5 0 0 1 7.5 11h1a.5.5 0 0 1 .474.658l-.28.842H9.5a.5.5 0 0 1 .39.812l-2 2.5a.5.5 0 0 1-.875-.433L7.36 14H6.5a.5.5 0 0 1-.447-.724z"/></svg>');
    }

    .SyncIndicator {
        position: fixed;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        margin-bottom: env(safe-area-inset-bottom);
        z-index: 1001;
        text-align: center;
    }

        .SyncIndicator > button {
            background-position: center;
            background-size: 4rem;
            background-repeat: no-repeat;
            background-color: rgba(255, 255,255,.25);
            color: rgba(255, 255,255,.5);
            border-radius: 1rem 1rem 0 0;
            border: none;
            height: 5rem;
            width: 5rem;
            font-size: 1.1rem;
            font-weight: bold;
        }

            .SyncIndicator > button.Internet {
                background-image: var(--cloud);
            }

            .SyncIndicator > button.NoInternet {
                background-image: var(--cloudLightning);
            }

            .SyncIndicator > button.Internet > span {
                display: inline-block;
                height: 5rem;
                line-height: 5rem;
            }

            .SyncIndicator > button.NoInternet > span {
                display: inline-block;
                height: 5rem;
                line-height: 3.9rem;
            }

</style>

@code {

    [Inject]
    IWorkflowData DataManager { set; get; } = default!;

    [Inject]
    NavigationManager Nav { set; get; } = default!;

    [Parameter]
    public bool SuppressClickableCloud { set; get; } = true;

    // private bool NoInternet = false;

    private bool InternetConnected = true;
    private int SyncCount = 0;

    private string SyncAriaLabel => InternetConnected
        ? $"{SyncCount} item{(SyncCount == 1 ? "" : "s")} waiting to sync. Open sync page."
        : $"Offline. {SyncCount} item{(SyncCount == 1 ? "" : "s")} queued to sync when connection returns. Open sync page.";

    private void GoToSyncPage()
    {
        Nav.NavigateTo("/sync");
    }

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();

        DataManager.OnSyncCountChanged += SyncCountChanged;
        DataManager.OnInternetConnectionStateChanged += ConnectionStateChange;

        await DataManager.CheckStatuses();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        StateHasChanged();
    }

    public void ConnectionStateChange(bool connected)
    {
        if (InternetConnected != connected)
        {
            InternetConnected = connected;
            StateHasChanged();
        }
    }

    public void SyncCountChanged(int count)
    {
        if (SyncCount != count)
        {
            SyncCount = count;
            StateHasChanged();
        }
    }


    public void Dispose()
    {
        DataManager.OnSyncCountChanged -= SyncCountChanged;
        DataManager.OnInternetConnectionStateChanged -= ConnectionStateChange;
    }
}
