<style>
    .tiny-picker-list {
        list-style-type: none;
        padding: 0;
        margin: 0;
        max-height: 500px; 
        overflow-y: auto; 
        scrollbar-width: auto; 
        scrollbar-color: white var(--ThemeColor); 
    }

    .tiny-picker-item {
        padding: 15px;
        margin: 5px 0;
        border: 1px solid var(--TertiaryColor);
        cursor: pointer;
        font-size: 16px;
        border-radius: 5px;
        text-align: center;
        transition: background-color 0.3s ease;
    }

        .tiny-picker-item.even {
            background-color: var(--SelectedSecondaryColor); 
        }

        .tiny-picker-item.odd {
            background-color: var(--ThemeColor);
        }

        .tiny-picker-item:hover {
            background-color: var(--SecondaryColor); 
            color: black;
            font-weight: bold;
        }
    
    .tiny-picker-list::-webkit-scrollbar {
        width: 20px; 
        height: 20px; 
    }

    .tiny-picker-list::-webkit-scrollbar-track {
        background: var(--ThemeColor);
    }

    .tiny-picker-list::-webkit-scrollbar-thumb {
        background-color: white; 
        border-radius: 10px; 
        border: 4px solid var(--ThemeColor); 
    }
        
        .tiny-picker-list::-webkit-scrollbar-thumb:hover {
            background-color: lightgrey; 
        }
</style>


<h4>@Title</h4>
@if ((DataList?.Count ?? 0) > 0)
{
    <ul class="tiny-picker-list">
        @for (int i = 0; i < DataList.Count; i++)
        {
            var item = DataList[i];
            var rowClass = i % 2 == 0 ? "tiny-picker-item even" : "tiny-picker-item odd"; 

            <li class="@rowClass" @onclick="() => OnItemTapped(item)">
                <span>@item</span>
            </li>
        }
    </ul>
}

@code {
    [Parameter]
    [EditorRequired]
    public List<string> DataList { get; set; } = new List<string>();

    [Parameter]
    public string? Title { get; set; } = "Select Item";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public bool AppendMode { get; set; } = false; // False for overwrite, true for append

    private async Task OnItemTapped(string item)
    {
        if (AppendMode)
        {
            if (!string.IsNullOrEmpty(Value))
            {
                var values = Value.Split(new[] { "\r\n" }, StringSplitOptions.None).ToList();
                if (values.Contains(item))
                {
                    values.Remove(item); // Unselect
                }
                else
                {
                    values.Add(item); // pick me!
                }
                Value = string.Join("\r\n", values);
            }
            else
            {
                Value = item;
            }
        }
        else
        {
            if (Value == item)
            {
                Value = null; // Unselect if already selected
            }
            else
            {
                Value = item; // pick it baby
            }
        }

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
    }
}
