@if (Show)
{
    <div class="ICS-dialog" @onkeydown="HandleKeyDown">
        <div class="ICS-dialog-content" role="dialog" aria-modal="true" aria-labelledby="@HeaderId"
             tabindex="-1" @ref="ContentRef">
            <div class="ICS-dialog-header">
                <h2 id="@HeaderId">@HeaderText</h2>
            </div>
            <div class="ICS-dialog-body">
                <div class="ICS-dialog-prompt" style="@CustomBodyStyle">
                    @if (ShowCommentBox && TableData is not null)
                    {

                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(PromptText))
                        {
                            <p>@((MarkupString)PromptText)</p>
                        }
                        @if (ChildContent is not null)
                        {
                            @ChildContent
                        }
                    }
                    @if (TableData is not null)
                    {
                        <table class="ICS-table">
                            @if (!string.IsNullOrEmpty(TableCol1Header) && !string.IsNullOrEmpty(TableCol2Header))
                            {
                                <tr>
                                    <th style="width: 40%;"><center>@TableCol1Header</center></th>
                                    <th><center>@TableCol2Header</center></th>
                                </tr>
                            }
                            @foreach (var item in TableData!)
                            {
                                <tr>
                                    <td class="keycol">
                                        @if (!string.IsNullOrEmpty(item.Key) && item.Key.Trim().Length > 0)
                                        {
                                            @string.Concat(item.Key, ":")
                                        }
                                        else
                                        {

                                            @item.Key
                                        }
                                    </td>
                                    <td class="valcol">@item.Value</td>
                                </tr>
                            }
                        </table>
                    }
                    @if (InputBoxOption && ShowCommentBox)
                    {
                        <div class="ICS-dialog-commentbox">
                            <textarea rows=7 @bind="CommentValue" placeholder="@PlaceholderText" />
                        </div>
                    }
                    <div class="ICS-dialog-footer">

                        @if (!string.IsNullOrEmpty(OptButtonText))
                        {
                            @if (InputBoxOption && !ShowCommentBox)
                            {
                                <button class="ICS-optbtn @DefaultCheck(3)" @onclick="() => CommentWanted()">@OptButtonText</button>
                            }
                            else
                            {
                                <button class="ICS-optbtn @DefaultCheck(3)" @onclick="() => ButtonClicked(3)">@OptButtonText</button>
                            }
                        }
                        @if (!ShowCommentBox)
                        {
                            @if (!string.IsNullOrEmpty(OkButtonText))
                            {
                                <button class="ICS-okbtn @DefaultCheck(1)" @onclick="() => ButtonClicked(1)">@OkButtonText</button>
                            }
                        }
                        @if (!string.IsNullOrEmpty(CancelButtonText))
                        {
                            <button class="ICS-cancelbtn @DefaultCheck(2)" @onclick="() => ButtonClicked(2)"> @CancelButtonText</button>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {



    // Use this for async wait for dialog result!
