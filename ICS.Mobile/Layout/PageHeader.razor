

<div class="appHeader">
    <div class="left">
        <a href="@ReturnURL" class="headerButton goBack">
            <i class="icon bi bi-arrow-left section-title"></i>
        </a>
    </div>
    <div class="pageTitle">
        @PageTitle
    </div>
</div>
@code {

    [Parameter]
    public string PageTitle { set; get; } = "Page Title";

    [Parameter]
    public string ReturnURL { set; get; } = "/";
}